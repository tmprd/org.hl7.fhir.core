         fhir:key [ fhir:v "vsp-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If there is no component or hasMember element then either a value[x] or a data absent reason must be present." ] ;
         fhir:expression [ fhir:v "(component.empty() and hasMember.empty()) implies (dataAbsentReason.exists() or value.exists())" ] ;
