     fhir:element ( [
       fhir:id [ fhir:v "BiologicallyDerivedProduct" ] ;
       fhir:path [ fhir:v "BiologicallyDerivedProduct" ] ;
       fhir:short [ fhir:v "Medical Product of Human Origin Profile " ] ;
       fhir:definition [ fhir:v "This profile is designed for biologically derived products that are derived from a human donor and intended for clinical application in a human recipient. Donor and recipient might, or might not, be the same individual. Products of this nature are referred to as medical products of human origin (MPHO) and have specific traceability requirements to ensure that the bi-directional link between donor and recipient is maintained. The profile specifies the essential identifiers for traceability as required elements." ] ;
       fhir:comment [ fhir:v "Substances include, but are not limited to: whole blood, bone marrow, organs, and manipulated blood cells." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
