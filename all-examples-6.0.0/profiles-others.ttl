       ] [
         fhir:key [ fhir:v "obs-6" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Observation.dataAbsentReason SHALL only be present if Observation.value[x] is not present" ] ;
         fhir:expression [ fhir:v "dataAbsentReason.empty() or value.empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Observation"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Observation>
