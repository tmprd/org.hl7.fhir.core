     fhir:element ( [
       fhir:id [ fhir:v "NamingSystem" ] ;
       fhir:path [ fhir:v "NamingSystem" ] ;
       fhir:short [ fhir:v "System of unique identification" ] ;
       fhir:definition [ fhir:v "A curated namespace that issues unique symbols within that namespace for the identification of concepts, people, devices, etc.  Represents a \"System\" used within the Identifier and Coding data types." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "NamingSystem" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "cnl-0" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "Name should be usable as an identifier for the module by machine processing applications such as code generation" ] ;
         fhir:expression [ fhir:v "name.exists() implies name.matches('^[A-Z]([A-Za-z0-9_]){1,254}$')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/NamingSystem"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/NamingSystem>
         ]
       ] [
         fhir:key [ fhir:v "nsd-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Root systems cannot have uuid identifiers" ] ;
         fhir:expression [ fhir:v "kind != 'root' or uniqueId.all(type != 'uuid')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/NamingSystem"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/NamingSystem>
         ]
