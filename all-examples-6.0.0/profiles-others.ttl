  fhir:version [ fhir:v "6.0.0-ballot3"] ; # 
  fhir:name [ fhir:v "PublishableNamingSystem"] ; # 
  fhir:title [ fhir:v "Publishable NamingSystem"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
