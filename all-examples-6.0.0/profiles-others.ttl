  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Body Mass Index (BMI) Profile" ] ;
       fhir:definition [ fhir:v "This profile defines  how to represent Body Mass Index (BMI) observations in FHIR using a standard LOINC code and UCUM units of measure." ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "vs-4" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For single vital signs observations (that do not require use of components or hasMember), then either a value[x] or a data absent reason must be present." ] ;
         fhir:expression [ fhir:v "dataAbsentReason.exists() or value.exists()" ]
       ] )
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:short [ fhir:v "Body Mass Index (BMI)" ] ;
       fhir:definition [ fhir:v "Body Mass Index (BMI)" ] ;
       fhir:pattern [
         a fhir:CodeableConcept, loinc:39156-5 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://loinc.org"^^xsd:anyURI ;
             fhir:l <http://loinc.org>
           ] ;
           fhir:code [ fhir:v "39156-5" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
