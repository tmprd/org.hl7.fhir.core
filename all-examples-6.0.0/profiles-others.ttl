         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "if Observation.effective[x] (as dateTime) has a value then that value shall be precise at least to the day" ] ;
         fhir:expression [ fhir:v "(effective as dateTime).toString().length() >= 8" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/vitalsigns"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/vitalsigns>
         ]
       ] [
         fhir:key [ fhir:v "vsp-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If there is no component or hasMember element then either a value[x] or a data absent reason must be present." ] ;
         fhir:expression [ fhir:v "(component.empty() and hasMember.empty()) implies (dataAbsentReason.exists() or value.exists())" ] ;
