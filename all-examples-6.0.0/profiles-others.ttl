         fhir:key [ fhir:v "obs-10" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Observation.component.dataAbsentReason SHALL only be present if Observation.component.value[x] is not present" ] ;
         fhir:expression [ fhir:v "component.empty() or component.where(dataAbsentReason.exists()).all(value.empty())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Observation"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Observation>
         ]
       ] [
         fhir:key [ fhir:v "obs-11" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "if organizer exists and organizer = true, then value[x], dataAbsentReason and component SHALL NOT be present" ] ;
         fhir:expression [ fhir:v "(organizer.exists() and organizer.allTrue()) implies (value.empty() and dataAbsentReason.empty() and component.empty())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Observation"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Observation>
         ]
       ] [
         fhir:key [ fhir:v "obs-12" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "All observations SHOULD have a performer" ] ;
         fhir:expression [ fhir:v "performer.exists()" ] ;
         fhir:source [
