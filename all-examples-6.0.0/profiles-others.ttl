  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Vital Signs Panel Profile" ] ;
       fhir:definition [ fhir:v "This profile defines the top-level grouping structure for a set of vital signs. It has no value in Observation.valueQuantity ; instead, it just includes related links (with type=has-member) to the Observations in this set (e.g. respiratory rate, heart rate, BP - with a minimum of 2 members of the set/panel required)." ]
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:short [ fhir:v "Vital Signs Panel" ] ;
       fhir:definition [ fhir:v "Vital Signs Panel" ] ;
       fhir:alias ( [ fhir:v "Panel Name" ] [ fhir:v "Panel Code" ] ) ;
       fhir:pattern [
         a fhir:CodeableConcept, loinc:85353-1 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://loinc.org"^^xsd:anyURI ;
             fhir:l <http://loinc.org>
           ] ;
           fhir:code [ fhir:v "85353-1" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "VitalSignsPanel"
           ]
         ] ) ;
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:description [ fhir:v "This identifies the set of LOINC codes that are appropriate for representing a panel of vital sign measurements in Observation.code." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-vitalsign-panel"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/observation-vitalsign-panel>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.hasMember" ] ;
       fhir:path [ fhir:v "Observation.hasMember" ] ;
       fhir:min [ fhir:v "2"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

