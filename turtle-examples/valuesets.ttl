       fhir:v "cds"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/fhir-types"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/fhir-types>
  ] ; # 
