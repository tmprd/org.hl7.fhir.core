  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem medicinal-product-type</b>\n            </p>\n            <a name=\"medicinal-product-type\"> </a>\n            <a name=\"hcmedicinal-product-type\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/medicinal-product-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">MedicinalProduct\n                  <a name=\"medicinal-product-type-MedicinalProduct\"> </a>\n                </td>\n                <td>Medicinal Product</td>\n                <td>Any substance or combination of substances that may be administered to human beings (or animals) for treating or preventing disease, or with the intent to make a medical diagnosis or to restore, correct or modify physiological functions. Its regulatory status is authorized/marketed for commercial use.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">InvestigationalProduct\n                  <a name=\"medicinal-product-type-InvestigationalProduct\"> </a>\n                </td>\n                <td>Investigational Medicinal Product</td>\n                <td>A medicinal product which is being tested or used as a reference, including as a placebo, in a clinical trial. Its regulatory status is under evaluation in a clinical trial; might or might not have marketing authorization.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
