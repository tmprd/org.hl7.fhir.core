  fhir:title [ fhir:v "W3c Provenance Activity Type"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2024-06-12"^^xsd:date] ; # 
