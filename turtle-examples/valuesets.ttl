  fhir:concept ( [
     fhir:code [ fhir:v "Base" ] ;
     fhir:display [ fhir:v "Base" ] ;
     fhir:definition [ fhir:v "Base Type: Base definition for all types defined in FHIR type system." ] ;
     fhir:property ( [
       fhir:code [ fhir:v "abstract-type" ] ;
       fhir:value [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] ) ;
     fhir:concept ( [
       fhir:code [ fhir:v "Element" ] ;
       fhir:display [ fhir:v "Element" ] ;
       fhir:definition [ fhir:v "Element Type: Base definition for all elements in a resource." ] ;
       fhir:property ( [
         fhir:code [ fhir:v "kind" ] ;
         fhir:value [
           a fhir:Code ;
           fhir:v "datatype"
         ]
       ] [
         fhir:code [ fhir:v "abstract-type" ] ;
         fhir:value [
           a fhir:Boolean ;
           fhir:v true
         ]
       ] ) ;
       fhir:concept ( [
         fhir:code [ fhir:v "BackboneElement" ] ;
         fhir:display [ fhir:v "BackboneElement" ] ;
         fhir:definition [ fhir:v "BackboneElement Type: Base definition for all elements that are defined inside a resource - but not those in a data type." ] ;
         fhir:property ( [
           fhir:code [ fhir:v "kind" ] ;
           fhir:value [
             a fhir:Code ;
             fhir:v "datatype"
           ]
         ] [
           fhir:code [ fhir:v "abstract-type" ] ;
           fhir:value [
             a fhir:Boolean ;
             fhir:v true
           ]
         ] )
       ] [
         fhir:code [ fhir:v "DataType" ] ;
         fhir:display [ fhir:v "DataType" ] ;
         fhir:definition [ fhir:v "DataType Type: The base class for all re-useable types defined as part of the FHIR Specification." ] ;
         fhir:property ( [
           fhir:code [ fhir:v "kind" ] ;
           fhir:value [
             a fhir:Code ;
             fhir:v "datatype"
           ]
         ] [
           fhir:code [ fhir:v "abstract-type" ] ;
           fhir:value [
             a fhir:Boolean ;
             fhir:v true
           ]
         ] ) ;
         fhir:concept ( [
           fhir:code [ fhir:v "Address" ] ;
           fhir:display [ fhir:v "Address" ] ;
           fhir:definition [ fhir:v "Address Type: An address expressed using postal conventions (as opposed to GPS or other location definition formats).  This data type may be used to convey addresses for use in delivering mail as well as for visiting locations which might not be valid for mail delivery.  There are a variety of postal address formats defined around the world.\nThe ISO21090-codedString may be used to provide a coded representation of the contents of strings in an Address." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Annotation" ] ;
           fhir:display [ fhir:v "Annotation" ] ;
           fhir:definition [ fhir:v "Annotation Type: A  text note which also  contains information about who made the statement and when." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Attachment" ] ;
           fhir:display [ fhir:v "Attachment" ] ;
           fhir:definition [ fhir:v "Attachment Type: For referring to data content defined in other formats." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Availability" ] ;
           fhir:display [ fhir:v "Availability" ] ;
           fhir:definition [ fhir:v "Availability Type: Availability data for an {item}, declaring what days/times are available, and any exceptions. The exceptions could be textual only, e.g. Public holidays, or could be time period specific and indicate a specific years dates." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "BackboneType" ] ;
           fhir:display [ fhir:v "BackboneType" ] ;
           fhir:definition [ fhir:v "BackboneType Type: Base definition for the few data types that are allowed to carry modifier extensions." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] [
             fhir:code [ fhir:v "abstract-type" ] ;
             fhir:value [
               a fhir:Boolean ;
               fhir:v true
             ]
           ] ) ;
           fhir:concept ( [
             fhir:code [ fhir:v "Dosage" ] ;
             fhir:display [ fhir:v "Dosage" ] ;
             fhir:definition [ fhir:v "Dosage Type: Indicates how the medication is/was taken or should be taken by the patient." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "DosageCondition" ] ;
             fhir:display [ fhir:v "DosageCondition" ] ;
             fhir:definition [ fhir:v "DosageCondition Type: DosageCondition expresses a time or time period as relative to the time of an event defined in data types other than dateTime." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "DosageInstruction" ] ;
             fhir:display [ fhir:v "DosageInstruction" ] ;
             fhir:definition [ fhir:v "DosageInstruction Type: Indicates how the medication is/was taken or should be taken by the patient." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "DosageSafety" ] ;
             fhir:display [ fhir:v "DosageSafety" ] ;
             fhir:definition [ fhir:v "DosageSafety Type: Safety Details about the usage of the medication." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "ElementDefinition" ] ;
             fhir:display [ fhir:v "ElementDefinition" ] ;
             fhir:definition [ fhir:v "ElementDefinition Type: Captures constraints on each element within the resource, profile, or extension." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "MarketingStatus" ] ;
             fhir:display [ fhir:v "MarketingStatus" ] ;
             fhir:definition [ fhir:v "MarketingStatus Type: The marketing status describes the date when an item is actually put on the market or the date as of which it is no longer available." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "ProductShelfLife" ] ;
             fhir:display [ fhir:v "ProductShelfLife" ] ;
             fhir:definition [ fhir:v "ProductShelfLife Type: The shelf-life and storage information for a medicinal product item or container can be described using this class." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "RelativeTime" ] ;
             fhir:display [ fhir:v "RelativeTime" ] ;
             fhir:definition [ fhir:v "RelativeTime Type: RelativeTime expresses a time or time period as relative to the time of an event defined in data types other than dateTime." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] [
             fhir:code [ fhir:v "Timing" ] ;
             fhir:display [ fhir:v "Timing" ] ;
             fhir:definition [ fhir:v "Timing Type: Specifies an event that may occur multiple times. Timing schedules are used to record when things are planned, expected or requested to occur. The most common usage is in dosage instructions for medications. They are also used when planning care of various kinds, and may be used for reporting the schedule to which past regular activities were carried out." ] ;
             fhir:property ( [
               fhir:code [ fhir:v "kind" ] ;
               fhir:value [
                 a fhir:Code ;
                 fhir:v "datatype"
               ]
             ] )
           ] )
         ] [
           fhir:code [ fhir:v "CodeableConcept" ] ;
           fhir:display [ fhir:v "CodeableConcept" ] ;
           fhir:definition [ fhir:v "CodeableConcept Type: A concept that may be defined by a formal reference to a terminology or ontology or may be provided by text." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "CodeableReference" ] ;
           fhir:display [ fhir:v "CodeableReference" ] ;
           fhir:definition [ fhir:v "CodeableReference Type: A reference to a resource (by instance), or instead, a reference to a concept defined in a terminology or ontology (by class)." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Coding" ] ;
           fhir:display [ fhir:v "Coding" ] ;
           fhir:definition [ fhir:v "Coding Type: A reference to a code defined by a terminology system." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ContactDetail" ] ;
           fhir:display [ fhir:v "ContactDetail" ] ;
           fhir:definition [ fhir:v "ContactDetail Type: Specifies contact information for a person or organization." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ContactPoint" ] ;
           fhir:display [ fhir:v "ContactPoint" ] ;
           fhir:definition [ fhir:v "ContactPoint Type: Details for all kinds of technology mediated contact points for a person or organization, including telephone, email, etc." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "DataRequirement" ] ;
           fhir:display [ fhir:v "DataRequirement" ] ;
           fhir:definition [ fhir:v "DataRequirement Type: Describes a required data item for evaluation in terms of the type of data, and optional code or date-based filters of the data." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Expression" ] ;
           fhir:display [ fhir:v "Expression" ] ;
           fhir:definition [ fhir:v "Expression Type: A expression that is evaluated in a specified context and returns a value. The context of use of the expression must specify the context in which the expression is evaluated, and how the result of the expression is used." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ExtendedContactDetail" ] ;
           fhir:display [ fhir:v "ExtendedContactDetail" ] ;
           fhir:definition [ fhir:v "ExtendedContactDetail Type: Specifies contact information for a specific purpose over a period of time, might be handled/monitored by a specific named person or organization." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Extension" ] ;
           fhir:display [ fhir:v "Extension" ] ;
           fhir:definition [ fhir:v "Extension Type: Optional Extension Element - found in all resources." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
               a fhir:Code ;
               fhir:v "datatype"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "HumanName" ] ;
           fhir:display [ fhir:v "HumanName" ] ;
           fhir:definition [ fhir:v "HumanName Type: A name, normally of a human, that can be used for other living entities (e.g. animals but not organizations) that have been assigned names by a human and may need the use of name parts or the need for usage information." ] ;
           fhir:property ( [
