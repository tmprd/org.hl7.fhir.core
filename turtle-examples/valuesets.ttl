  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet immunization-route</b>\n            </p>\n            <a name=\"immunization-route\"> </a>\n            <a name=\"hcimmunization-route\"> </a>\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html\">\n                  <code>http://terminology.hl7.org/CodeSystem/v3-RouteOfAdministration</code>\n                </a>\n                <span title=\"Version is not explicitly stated, which means it is fixed to 4.0.0, the version found through the package references\"> version ?4.0.0</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                    <td>\n                      <b>Definition</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-IDINJ\">IDINJ</a>\n                    </td>\n                    <td>Injection, intradermal</td>\n                    <td>Injection, intradermal</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-IM\">IM</a>\n                    </td>\n                    <td>Injection, intramuscular</td>\n                    <td>Injection, intramuscular</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-IVINJ\">IVINJ</a>\n                    </td>\n                    <td>Injection, intravenous</td>\n                    <td>Injection, intravenous</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-PO\">PO</a>\n                    </td>\n                    <td>Swallow, oral</td>\n                    <td>Swallow, oral</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-SQ\">SQ</a>\n                    </td>\n                    <td>Injection, subcutaneous</td>\n                    <td>Injection, subcutaneous</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-RouteOfAdministration.html#v3-RouteOfAdministration-TRNSDERM\">TRNSDERM</a>\n                    </td>\n                    <td>Transdermal</td>\n                    <td>Transdermal</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral ]
