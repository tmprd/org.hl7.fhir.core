     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet immunization-target-disease</b>\n            </p>\n            <a name=\"immunization-target-disease\"> </a>\n            <a name=\"hcimmunization-target-disease\"> </a>\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/397428000\">397428000</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Diphtheria</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/27836007\">27836007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Pertussis</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/76902006\">76902006</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Tetanus</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/721764008\">721764008</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Infection caused by Human poliovirus</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/14189004\">14189004</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Measles</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/36989005\">36989005</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Mumps</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/36653000\">36653000</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Rubella</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/16814004\">16814004</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Pneumococcal infectious disease</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/23511006\">23511006</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Meningococcal infectious disease</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/709410003\">709410003</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Haemophilus influenzae type b infection</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/56717001\">56717001</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Tuberculosis</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/363354003\">363354003</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Malignant neoplasm of cervix uteri</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/266113007\">266113007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Genital warts</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/415822001\">415822001</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Viral gastroenteritis caused by Rotavirus</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/66071002\">66071002</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Type B viral hepatitis</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/40468003\">40468003</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Viral hepatitis, type A</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/7111000119109\">7111000119109</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Viral hepatitis E</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/719590007\">719590007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Influenza caused by seasonal influenza virus</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/719865001\">719865001</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Influenza caused by pandemic influenza virus</td>\n                  </tr>\n                  <tr>\n                    <td>\