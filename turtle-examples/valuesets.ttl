     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem measure-supplemental-data-example</b>\n            </p>\n            <a name=\"measure-supplemental-data-example\"> </a>\n            <a name=\"hcmeasure-supplemental-data-example\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/measure-supplemental-data-example</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">age\n                  <a name=\"measure-supplemental-data-example-age\"> </a>\n                </td>\n                <td>Age</td>\n                <td>Age Supplemental Data.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">gender\n                  <a name=\"measure-supplemental-data-example-gender\"> </a>\n                </td>\n                <td>Gender</td>\n                <td>Gender Supplemental Data .</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ethnicity\n                  <a name=\"measure-supplemental-data-example-ethnicity\"> </a>\n                </td>\n                <td>Ethnicity</td>\n                <td>Ethnicity Supplemental Data .</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">payer\n                  <a name=\"measure-supplemental-data-example-payer\"> </a>\n                </td>\n                <td>Payer</td>\n                <td>Payer Supplemental Data.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
