       fhir:v "http://hl7.org/fhir/type-properties#kind"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/type-properties#kind>
     ] ;
     fhir:type [ fhir:v "code" ]
  ] [
     fhir:code [ fhir:v "interface" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/fhir/type-properties#interface"^^xsd:anyURI ;
