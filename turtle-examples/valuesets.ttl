           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "A device with demonstrated safety in the MR environment within defined conditions. At a minimum, address the conditions of the static magnetic field, the switched gradient magnetic field and the radiofrequency fields. Additional conditions, including specific configurations of the item, may be required. See ASTM F2503"
           ]
         ] ) ;
         fhir:code [ fhir:v "C106046" ] ;
         fhir:display [ fhir:v "Magnetic Resonance Conditional" ] ;
         fhir:designation ( [
           fhir:value [ fhir:v "MR Conditional" ]
         ] )
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/valueset-concept-definition>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "The device poses no known hazards resulting from exposure to any MR environment. MR Safe items are composed of materials that are electrically nonconductive, nonmetallic, and nonmagnetic. See ASTM F2503"
           ]
         ] ) ;
         fhir:code [ fhir:v "C106045" ] ;
         fhir:display [ fhir:v "Magnetic Resonance Safe" ] ;
         fhir:designation ( [
           fhir:value [ fhir:v "MR Safe" ]
         ] )
       ] [
         fhir:extension ( [
           fhir:url [
