     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem risk-assessment-type-example</b>\n            </p>\n            <a name=\"risk-assessment-type-example\"> </a>\n            <a name=\"hcrisk-assessment-type-example\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/risk-assessment-type-example</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">renal-risk\n                  <a name=\"risk-assessment-type-example-renal-risk\"> </a>\n                </td>\n                <td>Renal Risk</td>\n                <td>Assessment of Renal Risk</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">cardiovascular-risk\n                  <a name=\"risk-assessment-type-example-cardiovascular-risk\"> </a>\n                </td>\n                <td>Cardiovascular Risk</td>\n                <td>Assessment of Cardiovascular Risk</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">hepatic-risk\n                  <a name=\"risk-assessment-type-example-hepatic-risk\"> </a>\n                </td>\n                <td>Hepatic Risk</td>\n                <td>Assessment of Hepatic Risk</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">breast-cancer-risk\n                  <a name=\"risk-assessment-type-example-breast-cancer-risk\"> </a>\n                </td>\n                <td>Breast Cancer Risk</td>\n                <td>Assessment of Breast Cancer Risk</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
