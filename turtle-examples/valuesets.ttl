           fhir:code [ fhir:v "ImagingStudy" ] ;
           fhir:display [ fhir:v "ImagingStudy" ] ;
           fhir:definition [ fhir:v "Representation of the content produced in a DICOM imaging study. A study comprises a set of series, each of which includes a set of images or other data objects (called Service-Object Pair Instances or SOP Instances) acquired or produced in a common context." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
