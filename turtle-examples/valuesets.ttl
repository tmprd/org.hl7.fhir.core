           fhir:code [ fhir:v "Signature" ] ;
           fhir:display [ fhir:v "Signature" ] ;
           fhir:definition [ fhir:v "Signature Type: A signature along with supporting context. The signature may be a digital signature that is cryptographic in nature, or some other signature acceptable to the domain. This other signature may be as simple as a graphical image representing a hand-written signature, or a signature ceremony Different signature approaches have different utilities." ] ;
