     fhir:definition [ fhir:v "The specimen cannot be used because of a quality issue such as a broken container, contamination, or too old." ]
  ] [
     fhir:code [ fhir:v "entered-in-error" ] ;
     fhir:display [ fhir:v "Entered in Error" ] ;
     fhir:definition [ fhir:v "The specimen was entered in error and therefore nullified." ]
  ] ) . # 

