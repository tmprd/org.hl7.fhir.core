  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      \n      \n      \n      \n            <ul>\n        \n        \n        \n        \n              <li>Include these codes as defined in \n          \n          \n          \n          \n                <a href=\"codesystem-restful-interaction.html\">\n            \n            \n            \n            \n                  <code>http://hl7.org/fhir/restful-interaction</code>\n          \n          \n          \n          \n                </a>\n          \n          \n          \n          \n                <table class=\"none\">\n            \n            \n            \n            \n                  <tr>\n              \n              \n              \n              \n                    <td style=\"white-space:nowrap\">\n                \n                \n                \n                \n                      <b>Code</b>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <b>Display</b>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <b>Definition</b>\n              \n              \n              \n              \n                    </td>\n            \n            \n            \n            \n                  </tr>\n            \n            \n            \n            \n                  <tr>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <a href=\"codesystem-restful-interaction.html#restful-interaction-transaction\">transaction</a>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>transaction</td>\n              \n              \n              \n              \n                    <td>Update, create or delete a set of resources as a single transaction.</td>\n            \n            \n            \n            \n                  </tr>\n            \n            \n            \n            \n                  <tr>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <a href=\"codesystem-restful-interaction.html#restful-interaction-batch\">batch</a>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>batch</td>\n              \n              \n              \n              \n                    <td>perform a set of a separate interactions in a single http operation</td>\n            \n            \n            \n            \n                  </tr>\n            \n            \n            \n            \n                  <tr>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <a href=\"codesystem-restful-interaction.html#restful-interaction-search-system\">search-system</a>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>search-system</td>\n              \n              \n              \n              \n                    <td>Search all resources based on some filter criteria.</td>\n            \n            \n            \n            \n                  </tr>\n            \n            \n            \n            \n                  <tr>\n              \n              \n              \n              \n                    <td>\n                \n                \n                \n                \n                      <a href=\"codesystem-restful-interaction.html#restful-interaction-history-system\">history-system</a>\n              \n              \n              \n              \n                    </td>\n              \n              \n              \n              \n                    <td>history-system</td>\n              \n              \n              \n              \n                    <td>Retrieve the change history for all resources on a system.</td>\n            \n            \n            \n            \n                  </tr>\n          \n          \n          \n          \n                </table>\n        \n        \n        \n        \n              </li>\n      \n      \n      \n      \n            </ul>\n    \n    \n    \n    \n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
