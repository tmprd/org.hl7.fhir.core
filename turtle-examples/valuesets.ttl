     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem guidance-module-code-example</b>\n            </p>\n            <a name=\"guidance-module-code-example\"> </a>\n            <a name=\"hcguidance-module-code-example\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/guidance-module-code-example</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">bmi-calculator\n                  <a name=\"guidance-module-code-example-bmi-calculator\"> </a>\n                </td>\n                <td>BMI Calculator</td>\n                <td>A Body Mass Index (BMI) calculator.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">mme-calculator\n                  <a name=\"guidance-module-code-example-mme-calculator\"> </a>\n                </td>\n                <td>MME Calculator</td>\n                <td>A Morphine Milligram Equivalent (MME) calculator.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">opioid-cds\n                  <a name=\"guidance-module-code-example-opioid-cds\"> </a>\n                </td>\n                <td>Opioid CDS</td>\n                <td>Clinical Decision Support for Opioid Prescribing.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">anc-cds\n                  <a name=\"guidance-module-code-example-anc-cds\"> </a>\n                </td>\n                <td>ANC CDS</td>\n                <td>Clinical Decision Support for Antenatal Care.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">chf-pathway\n                  <a name=\"guidance-module-code-example-chf-pathway\"> </a>\n                </td>\n                <td>CHF Pathway</td>\n                <td>Congestive Heart Failure Pathway</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">covid-19-severity\n                  <a name=\"guidance-module-code-example-covid-19-severity\"> </a>\n                </td>\n                <td>COVID-19 Severity Score</td>\n                <td>A COVID-19 Severity Score Calculator.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
