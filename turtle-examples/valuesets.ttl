     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "vocab"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "normative"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 4
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/codesystem-use-markdown"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/codesystem-use-markdown>
     ] ;
     fhir:value [
       a fhir:Boolean ;
       fhir:v true
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/concept-properties"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/concept-properties>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.4.1826" ]
  ] ) ; # 
  fhir:version [ fhir:v "6.0.0-snapshot1"] ; # 
  fhir:name [ fhir:v "ConceptProperties"] ; # 
  fhir:title [ fhir:v "FHIR Defined Concept Properties"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:publisher [ fhir:v "HL7 International / Terminology Infrastructure"] ; # 
  fhir:contact ( [
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://hl7.org/fhir" ]
     ] )
  ] [
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://www.hl7.org/Special/committees/Vocab/index.cfm" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "A set of common concept properties for use on coded systems throughout the FHIR eco-system."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
         fhir:l <http://unstats.un.org/unsd/methods/m49/m49.htm>
       ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:valueSet [
     fhir:v "http://hl7.org/fhir/ValueSet/concept-properties"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/ValueSet/concept-properties>
  ] ; # 
  fhir:content [ fhir:v "complete"] ; # 
  fhir:property ( [
     fhir:code [ fhir:v "dataType" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/fhir/concept-properties#dataType"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/concept-properties#dataType>
     ] ;
     fhir:description [ fhir:v "data type of property value" ] ;
     fhir:type [ fhir:v "code" ]
  ] [
     fhir:extension ( [
       fhir:url [
         fhir:v "http://hl7.org/fhir/StructureDefinition/codesystem-property-valueset"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/StructureDefinition/codesystem-property-valueset>
       ] ;
       fhir:value [
         a fhir:Canonical ;
         fhir:v "http://hl7.org/fhir/ValueSet/concept-property-type"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/ValueSet/concept-property-type>
       ]
     ] ) ;
     fhir:code [ fhir:v "status" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/fhir/concept-properties#status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/concept-properties#status>
     ] ;
     fhir:description [ fhir:v "A code that indicates the status of the concept. Typical values are active, experimental, deprecated, and retired" ] ;
     fhir:type [ fhir:v "code" ]
  ] ) ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "status" ] ;
     fhir:display [ fhir:v "Status" ] ;
     fhir:definition [ fhir:v "A code that indicates the status of the concept. Typical values are active, experimental, deprecated, and retired" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] )
  ] [
     fhir:id [ fhir:v "t1" ] ;
     fhir:code [ fhir:v "inactive" ] ;
     fhir:display [ fhir:v "Inactive" ] ;
     fhir:definition [ fhir:v "True if the concept is not considered active - e.g. not a valid concept any more. Property type is boolean, default value is false. Note that the status property may also be used to indicate that a concept is inactive" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "boolean"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "effectiveDate" ] ;
     fhir:display [ fhir:v "effectiveDate" ] ;
     fhir:definition [ fhir:v "The date at which the concept status was last changed" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "dateTime"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "deprecated" ] ;
     fhir:display [ fhir:v "Deprecated" ] ;
     fhir:definition [ fhir:v "The date at which a concept was deprecated. Concepts that are deprecated but not inactive can still be used, but their use is discouraged, and they should be expected to be made inactive in a future release. Property type is dateTime. Note that the status property may also be used to indicate that a concept is deprecated. This property is itself deprecated due to potential confusion with status - use deprecationDate instead" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "status" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "deprecated"
       ]
     ] [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "dateTime"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "deprecationDate" ] ;
     fhir:display [ fhir:v "Deprecation Date" ] ;
     fhir:definition [ fhir:v "The date at which a concept was deprecated. Concepts that are deprecated but not inactive can still be used, but their use is discouraged, and they should be expected to be made inactive in a future release. Property type is dateTime. Note that the status property may also be used to indicate that a concept is deprecated" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "dateTime"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "retirementDate" ] ;
     fhir:display [ fhir:v "Retirement Date" ] ;
     fhir:definition [ fhir:v "The date at which a concept was retired" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "dateTime"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "notSelectable" ] ;
     fhir:display [ fhir:v "Not Selectable" ] ;
     fhir:definition [ fhir:v "The concept is not intended to be chosen by the user - only intended to be used as a selector for other concepts. Note, though, that the interpretation of this is highly contextual; all concepts are selectable in some context. Property type is boolean, default value is false" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "boolean"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "parent" ] ;
     fhir:display [ fhir:v "Parent" ] ;
     fhir:definition [ fhir:v "The concept identified in this property is a parent of the concept on which it is a property. The property type will be 'code'. The meaning of 'parent' is defined by the hierarchyMeaning attribute" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "child" ] ;
     fhir:display [ fhir:v "Child" ] ;
     fhir:definition [ fhir:v "The concept identified in this property is a child of the concept on which it is a property. The property type will be 'code'. The meaning of 'child' is defined by the hierarchyMeaning attribute" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "partOf" ] ;
     fhir:display [ fhir:v "Part Of" ] ;
     fhir:definition [ fhir:v "The concept identified in this property (by its code) contains this concept as a component (i.e. a part-of relationship rather than a subsumption relationship such as elbow is part-of arm" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "synonym" ] ;
     fhir:display [ fhir:v "Synonym" ] ;
     fhir:definition [ fhir:v "This property contains an alternative code that may be used to identify this concept instead of the primary code. Synonyms should not be used due to the operational complexity they introduce - see alternateCode" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] [
       fhir:code [ fhir:v "status" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "deprecated"
       ]
     ] [
       fhir:code [ fhir:v "deprecationDate" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "2025-03-14"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "alternateCode" ] ;
     fhir:display [ fhir:v "Alternate Code" ] ;
     fhir:definition [ fhir:v "This property contains the code for another representation of this concept, with the same real-world meaning, in this code system." ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "code"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "comment" ] ;
     fhir:display [ fhir:v "Comment" ] ;
     fhir:definition [ fhir:v "A string that provides additional detail pertinent to the use or understanding of the concept" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "string"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "itemWeight" ] ;
     fhir:display [ fhir:v "itemWeight" ] ;
     fhir:definition [ fhir:v "A numeric value that allows the comparison (less than, greater than) or other numerical manipulation of a concept (e.g. Adding up components of a score). Scores are usually a whole number, but occasionally decimals are encountered in scores. In questionnaires, the item weight may be represented using the [[[http://hl7.org/fhir/StructureDefinition/itemWeight]]] extension" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "decimal"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "order" ] ;
     fhir:display [ fhir:v "Order" ] ;
     fhir:definition [ fhir:v "Order of the concept amongst sibling concepts as a decimal value" ] ;
     fhir:property ( [
       fhir:code [ fhir:v "dataType" ] ;
       fhir:value [
         a fhir:Code ;
         fhir:v "decimal"
       ]
     ] )
  ] [
     fhir:code [ fhir:v "definition" ] ;
     fhir:display [ fhir:v "Definition" ] ;
     fhir:definition [ fhir:v "A numeric value that allows the comparison (less than, greater than) or other numerical manipulation of a concept (e.g. Adding up components of a score). Scores are usually a whole number, but occasionally decimals are encountered in scores. In questionnaires, the item weight may be represented using the [[[http://hl7.org/fhir/StructureDefinition/itemWeight]]] extension" ] ;
     fhir:property ( [
