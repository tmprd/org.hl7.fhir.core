  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet allergyintolerance-code</b>\n            </p>\n            <a name=\"allergyintolerance-code\"> </a>\n            <a name=\"hcallergyintolerance-code\"> </a>\n            <p>This value set includes codes based on the following rules:</p>\n            <ul>\n              <li>Import all the codes that are contained in \n                <a href=\"valueset-substance-code.html\">Substance Code</a>\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 418038007 (Propensity to adverse reactions to substance)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 267425008 (Lactose intolerance)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 29736007 (Syndrome of carbohydrate intolerance)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 340519003 (Lysine intolerance)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 190753003 (Sucrose intolerance)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 413427002 (Acquired fructose intolerance (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 716186003 (No known allergy (situation))\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral ]
