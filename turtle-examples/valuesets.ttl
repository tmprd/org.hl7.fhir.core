     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem allergy-intolerance-criticality</b>\n            </p>\n            <a name=\"allergy-intolerance-criticality\"> </a>\n            <a name=\"hcallergy-intolerance-criticality\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/allergy-intolerance-criticality</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">low\n                  <a name=\"allergy-intolerance-criticality-low\"> </a>\n                </td>\n                <td>Low Risk</td>\n                <td>Worst case result of a future exposure is not assessed to be life-threatening or having high potential for organ system failure.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">high\n                  <a name=\"allergy-intolerance-criticality-high\"> </a>\n                </td>\n                <td>High Risk</td>\n                <td>Worst case result of a future exposure is assessed to be life-threatening or having high potential for organ system failure.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">unable-to-assess\n                  <a name=\"allergy-intolerance-criticality-unable-to-assess\"> </a>\n                </td>\n                <td>Unable to Assess Risk</td>\n                <td>Unable to assess the worst case result of a future exposure.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
