               a fhir:Code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "ResearchStudy" ] ;
           fhir:display [ fhir:v "ResearchStudy" ] ;
           fhir:definition [ fhir:v "A scientific study intended to increase health-related knowledge. For example, clinical trials are research studies that involve people. These studies may be related to new ways to screen, prevent, diagnose, and treat disease. They may also study certain outcomes and certain groups of people by looking at data collected in the past or future." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
