     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem identity-assuranceLevel</b>\n            </p>\n            <a name=\"identity-assuranceLevel\"> </a>\n            <a name=\"hcidentity-assuranceLevel\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/identity-assuranceLevel</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">level1\n                  <a name=\"identity-assuranceLevel-level1\"> </a>\n                </td>\n                <td>Level 1</td>\n                <td>Little or no confidence in the asserted identity's accuracy.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">level2\n                  <a name=\"identity-assuranceLevel-level2\"> </a>\n                </td>\n                <td>Level 2</td>\n                <td>Some confidence in the asserted identity's accuracy.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">level3\n                  <a name=\"identity-assuranceLevel-level3\"> </a>\n                </td>\n                <td>Level 3</td>\n                <td>High confidence in the asserted identity's accuracy.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">level4\n                  <a name=\"identity-assuranceLevel-level4\"> </a>\n                </td>\n                <td>Level 4</td>\n                <td>Very high confidence in the asserted identity's accuracy.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
