           fhir:display [ fhir:v "HealthcareService" ] ;
           fhir:definition [ fhir:v "The details of a healthcare service available at a location or in a catalog.  In the case where there is a hierarchy of services (for example, Lab -> Pathology -> Wound Cultures), this can be represented using a set of linked HealthcareServices." ] ;
