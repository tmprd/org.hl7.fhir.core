               a fhir:Code ;
               fhir:v "resource"
             ]
           ] )
         ] [
           fhir:code [ fhir:v "Patient" ] ;
           fhir:display [ fhir:v "Patient" ] ;
           fhir:definition [ fhir:v "Demographics and other administrative information about an individual or animal that is the subject of potential, past, current, or future health-related care, services, or processes." ] ;
