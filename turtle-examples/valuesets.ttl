  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem oligo-nucleotide-type</b>\n            </p>\n            <a name=\"oligo-nucleotide-type\"> </a>\n            <a name=\"hcoligo-nucleotide-type\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/oligo-nucleotide-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">antisense\n                  <a name=\"oligo-nucleotide-type-antisense\"> </a>\n                </td>\n                <td>Antisense oligonucleotide</td>\n                <td>An antisense oligonucleotide (ASO) that binds to a complementary mRNA sequence to inhibit gene expression.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">sirna\n                  <a name=\"oligo-nucleotide-type-sirna\"> </a>\n                </td>\n                <td>Small interfering RNA (siRNA)</td>\n                <td>A short double-stranded RNA that triggers degradation of a target mRNA through the RNA interference pathway.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">mirna\n                  <a name=\"oligo-nucleotide-type-mirna\"> </a>\n                </td>\n                <td>MicroRNA (miRNA)</td>\n                <td>A short non-coding RNA that regulates gene expression by base-pairing with target mRNAs.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">aptamer\n                  <a name=\"oligo-nucleotide-type-aptamer\"> </a>\n                </td>\n                <td>Aptamer</td>\n                <td>A short single-stranded oligonucleotide that binds a specific target through its three-dimensional structure.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">decoy\n                  <a name=\"oligo-nucleotide-type-decoy\"> </a>\n                </td>\n                <td>Decoy oligonucleotide</td>\n                <td>An oligonucleotide that mimics a regulatory binding site to sequester a transcription factor or other binding protein.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ribozyme\n                  <a name=\"oligo-nucleotide-type-ribozyme\"> </a>\n                </td>\n                <td>Ribozyme / DNAzyme</td>\n                <td>A catalytic oligonucleotide capable of cleaving a target nucleic acid.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">gene-fragment\n                  <a name=\"oligo-nucleotide-type-gene-fragment\"> </a>\n                </td>\n                <td>Gene fragment</td>\n                <td>A fragment of a gene such as a promoter, enhancer, coding region or silencer.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
