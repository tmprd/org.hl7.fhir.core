  fhir:property ( [
     fhir:code [ fhir:v "abstract-type" ] ;
     fhir:uri [
       fhir:v "http://hl7.org/fhir/type-properties#abstract-type"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/type-properties#abstract-type>
     ] ;
