<http://hl7.org/fhir/CodeSystem/etsi-signature-type> a fhir:CodeSystem ;
  fhir:id [ fhir:v "etsi-signature-type"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2026-10-21T19:40:39.479+00:00"^^xsd:dateTime ]
