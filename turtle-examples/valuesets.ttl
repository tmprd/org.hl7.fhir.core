  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet goal-description</b>\n            </p>\n            <a name=\"goal-description\"> </a>\n            <a name=\"hcgoal-description\"> </a>\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/2004005\">2004005</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Normal blood pressure</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/301475006\">301475006</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Does negotiate obstacles</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/282192007\">282192007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Able to walk up stairs</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/161922009\">161922009</a>\n                    </td>\n                    <td style=\"color: #cccccc\">No cough</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/228367002\">228367002</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Does not misuse drugs</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/1157152000\">1157152000</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Not at risk of absconding from healthcare setting</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/19063003\">19063003</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Arthroplasty of knee</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/700000006\">700000006</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Vaginal delivery of fetus</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/271651005\">271651005</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Stable blood pressure</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/716424007\">716424007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Able to mobilize over uneven ground</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral ]
