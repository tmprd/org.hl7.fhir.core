     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem global-langpack-support</b>\n            </p>\n            <a name=\"global-langpack-support\"> </a>\n            <a name=\"hcglobal-langpack-support\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/global-langpack-support</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">not-supported\n                  <a name=\"global-langpack-support-not-supported\"> </a>\n                </td>\n                <td>Not Supported</td>\n                <td>Language Packs are not supported at all</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">explicit\n                  <a name=\"global-langpack-support-explicit\"> </a>\n                </td>\n                <td>Language Packs Supported by request</td>\n                <td>The server supports language packs, but only when the value set asks for them, or they are requested explicitly by parameter.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">implicit\n                  <a name=\"global-langpack-support-implicit\"> </a>\n                </td>\n                <td>Global Language Packs Supported</td>\n                <td>Language Packs marked as 'global language packs' are automatically in scope when the relevant language is requested.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
