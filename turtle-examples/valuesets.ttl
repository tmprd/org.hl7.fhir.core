     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem claim-outcome</b>\n            </p>\n            <a name=\"claim-outcome\"> </a>\n            <a name=\"hcclaim-outcome\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/claim-outcome</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">queued\n                  <a name=\"claim-outcome-queued\"> </a>\n                </td>\n                <td>Queued</td>\n                <td>The Claim/Pre-authorization/Pre-determination has been received but processing has not begun.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">complete\n                  <a name=\"claim-outcome-complete\"> </a>\n                </td>\n                <td>Processing Complete</td>\n                <td>The processing has completed without errors</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">error\n                  <a name=\"claim-outcome-error\"> </a>\n                </td>\n                <td>Error</td>\n                <td>One or more errors have been detected in the Claim</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">partial\n                  <a name=\"claim-outcome-partial\"> </a>\n                </td>\n                <td>Partial Processing</td>\n                <td>No errors have been detected in the Claim and some of the adjudication has been performed.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
