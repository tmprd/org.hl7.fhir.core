<http://hl7.org/fhir/CodeSystem/encounter-businessstatus-inpatient> a fhir:CodeSystem ;
  fhir:id [ fhir:v "encounter-businessstatus-inpatient"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2026-10-21T19:40:39.479+00:00"^^xsd:dateTime ]
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem encounter-businessstatus-inpatient</b>\n            </p>\n            <a name=\"encounter-businessstatus-inpatient\"> </a>\n            <a name=\"hcencounter-businessstatus-inpatient\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2025-10-29T00:00:00Z</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/encounter-businessstatus-inpatient</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pre-admit\n                  <a name=\"encounter-businessstatus-inpatient-pre-admit\"> </a>\n                </td>\n                <td>Pre-admit</td>\n                <td>The patient has been pre-admitted but has not yet arrived at the facility.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pend-admit\n                  <a name=\"encounter-businessstatus-inpatient-pend-admit\"> </a>\n                </td>\n                <td>Pending Admit</td>\n                <td>The patient admission is pending.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">admit\n                  <a name=\"encounter-businessstatus-inpatient-admit\"> </a>\n                </td>\n                <td>Admitted</td>\n                <td>The patient has been admitted to the facility.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">discharge\n                  <a name=\"encounter-businessstatus-inpatient-discharge\"> </a>\n                </td>\n                <td>Discharge</td>\n                <td>The patient is in the process of being discharged or has been discharged.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">unknown\n                  <a name=\"encounter-businessstatus-inpatient-unknown\"> </a>\n                </td>\n                <td>Unknown</td>\n                <td>The inpatient business status is unknown. Note that \"unknown\" is a value of last resort and every attempt should be made to provide a meaningful value other than \"unknown\".</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
