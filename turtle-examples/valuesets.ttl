     fhir:definition [ fhir:v "Language Packs are not supported at all" ]
  ] [
     fhir:code [ fhir:v "explicit" ] ;
     fhir:display [ fhir:v "Language Packs Supported by request" ] ;
     fhir:definition [ fhir:v "The server supports language packs, but only when the value set asks for them, or they are requested explicitly by parameter." ]
  ] [
     fhir:code [ fhir:v "implicit" ] ;
     fhir:display [ fhir:v "Global Language Packs Supported" ] ;
     fhir:definition [ fhir:v "Language Packs marked as 'global language packs' are automatically in scope when the relevant language is requested." ]
  ] ) . # 

