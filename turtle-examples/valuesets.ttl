  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet condition-stage</b>\n            </p>\n            <a name=\"condition-stage\"> </a>\n            <a name=\"hccondition-stage\"> </a>\n            <p>This value set includes codes based on the following rules:</p>\n            <ul>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 385356007 (Tumor stage finding (finding))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 431855005 (Chronic kidney disease stage 1 (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 431856006 (Chronic kidney disease stage 2 (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 433144002 (Chronic kidney disease stage 3 (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 431857002 (Chronic kidney disease stage 4 (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 433146000 (Chronic kidney disease stage 5 (disorder))\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 408847006 (Retinopathy of prematurity stage 1 - demarcation line)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 408848001 (Retinopathy of prematurity stage 2 - intraretinal ridge)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 408849009 (Retinopathy of prematurity stage 3 - ridge with extraretinal fibrovascular proliferation)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 408850009 (Retinopathy of prematurity stage 4 - subtotal retinal detachment)\n              </li>\n              <li>Include codes from\n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span> where concept  is-a 408851008 (Retinopathy of prematurity stage 5 - total retinal detachment)\n              </li>\n              <li>Include these codes as defined in \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/416780008\">416780008</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Primary degenerative dementia of the Alzheimer type, presenile onset</td>\n                  </tr>\n                </table>\n              </li>\n              <li>Include these codes as defined in \n                <a href=\"http://www.snomed.org/\">\n                  <code>http://snomed.info/sct</code>\n                </a>\n                <span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://snomed.info/id/715345007\">715345007</a>\n                    </td>\n                    <td style=\"color: #cccccc\">Young onset Parkinson disease</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
