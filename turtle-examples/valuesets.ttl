           fhir:code [ fhir:v "Evidence" ] ;
           fhir:display [ fhir:v "Evidence" ] ;
           fhir:definition [ fhir:v "The Evidence Resource provides a machine-interpretable expression of an evidence concept including the evidence variables (e.g., population, exposures/interventions, comparators, outcomes, measured variables, confounding variables), the statistics, and the certainty of this evidence." ] ;
           fhir:property ( [
