           fhir:code [ fhir:v "Immunization" ] ;
           fhir:display [ fhir:v "Immunization" ] ;
           fhir:definition [ fhir:v "Describes the event of a patient being administered a vaccine or a record of an immunization as reported by a patient, a clinician or another party." ] ;
           fhir:property ( [
             fhir:code [ fhir:v "kind" ] ;
             fhir:value [
