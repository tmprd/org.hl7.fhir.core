     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem medicinal-product-name-part-type</b>\n            </p>\n            <a name=\"medicinal-product-name-part-type\"> </a>\n            <a name=\"hcmedicinal-product-name-part-type\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n              <p style=\"margin-bottom: 0px\">Profile: \n                <a href=\"broken-link.html\">http://hl7.org/fhir/StructureDefinition/shareablecodesystem</a>\n              </p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/medicinal-product-name-part-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">InventedNamePart\n                  <a name=\"medicinal-product-name-part-type-InventedNamePart\"> </a>\n                </td>\n                <td>Invented name part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ScientificNamePart\n                  <a name=\"medicinal-product-name-part-type-ScientificNamePart\"> </a>\n                </td>\n                <td>Scientific name part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">StrengthPart\n                  <a name=\"medicinal-product-name-part-type-StrengthPart\"> </a>\n                </td>\n                <td>Strength part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">DoseFormPart\n                  <a name=\"medicinal-product-name-part-type-DoseFormPart\"> </a>\n                </td>\n                <td>Pharmaceutical dose form part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">FormulationPart\n                  <a name=\"medicinal-product-name-part-type-FormulationPart\"> </a>\n                </td>\n                <td>Formulation part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">IntendedUsePart\n                  <a name=\"medicinal-product-name-part-type-IntendedUsePart\"> </a>\n                </td>\n                <td>Intended use part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">PopulationPart\n                  <a name=\"medicinal-product-name-part-type-PopulationPart\"> </a>\n                </td>\n                <td>Target population part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ContainerPart\n                  <a name=\"medicinal-product-name-part-type-ContainerPart\"> </a>\n                </td>\n                <td>Container or pack part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">DevicePart\n                  <a name=\"medicinal-product-name-part-type-DevicePart\"> </a>\n                </td>\n                <td>Device part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">TrademarkOrCompanyPart\n                  <a name=\"medicinal-product-name-part-type-TrademarkOrCompanyPart\"> </a>\n                </td>\n                <td>Trademark or company name part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">TimeOrPeriodPart\n                  <a name=\"medicinal-product-name-part-type-TimeOrPeriodPart\"> </a>\n                </td>\n                <td>Time/Period part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">FlavorPart\n                  <a name=\"medicinal-product-name-part-type-FlavorPart\"> </a>\n                </td>\n                <td>Flavor part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">DelimiterPart\n                  <a name=\"medicinal-product-name-part-type-DelimiterPart\"> </a>\n                </td>\n                <td>Delimiter part</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">LegacyNamePart\n                  <a name=\"medicinal-product-name-part-type-LegacyNamePart\"> </a>\n                </td>\n                <td>Legacy name</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SpeciesNamePart\n                  <a name=\"medicinal-product-name-part-type-SpeciesNamePart\"> </a>\n                </td>\n                <td>Target species name part</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
