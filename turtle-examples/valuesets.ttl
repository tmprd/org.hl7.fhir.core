           fhir:code [ fhir:v "Endpoint" ] ;
           fhir:display [ fhir:v "Endpoint" ] ;
           fhir:definition [ fhir:v "The technical details of an endpoint that can be used for electronic services, such as for web services providing XDS.b, a REST endpoint for another FHIR server, or a s/Mime email address. This may include any security context information." ] ;
