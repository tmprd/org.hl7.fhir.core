     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem task-reason</b>\n            </p>\n            <a name=\"task-reason\"> </a>\n            <a name=\"hctask-reason\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/task-reason</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">cancellation\n                  <a name=\"task-reason-cancellation\"> </a>\n                </td>\n                <td>Cancellation</td>\n                <td>The task is requesting a cancellation.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">fulfillment\n                  <a name=\"task-reason-fulfillment\"> </a>\n                </td>\n                <td>Fulfillment</td>\n                <td>The task is requesting fulfullment.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">merging\n                  <a name=\"task-reason-merging\"> </a>\n                </td>\n                <td>Merging</td>\n                <td>The task is requesting a merge.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">admittance\n                  <a name=\"task-reason-admittance\"> </a>\n                </td>\n                <td>Admittance</td>\n                <td>The task is requesting a patient to be admitted.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">authorization\n                  <a name=\"task-reason-authorization\"> </a>\n                </td>\n                <td>Authorization</td>\n                <td>The task is representing an authorization of service.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
