     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem interaction-type</b>\n            </p>\n            <a name=\"interaction-type\"> </a>\n            <a name=\"hcinteraction-type\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/interaction-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">drug-drug\n                  <a name=\"interaction-type-drug-drug\"> </a>\n                </td>\n                <td>drug to drug interaction</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">drug-food\n                  <a name=\"interaction-type-drug-food\"> </a>\n                </td>\n                <td>drug to food interaction</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">drug-test\n                  <a name=\"interaction-type-drug-test\"> </a>\n                </td>\n                <td>drug to laboratory test interaction</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">other\n                  <a name=\"interaction-type-other\"> </a>\n                </td>\n                <td>other interaction</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
