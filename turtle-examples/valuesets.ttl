           fhir:code [ fhir:v "ManufacturedItemDefinition" ] ;
           fhir:display [ fhir:v "ManufacturedItemDefinition" ] ;
           fhir:definition [ fhir:v "The definition and characteristics of a medicinal manufactured item, such as a tablet or capsule, as contained in a packaged medicinal product." ] ;
