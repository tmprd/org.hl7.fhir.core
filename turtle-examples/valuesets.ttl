  fhir:content [ fhir:v "complete"] ; # 
  fhir:concept ( [
     fhir:code [ fhir:v "off-pathway" ] ;
     fhir:display [ fhir:v "Off pathway" ] ;
     fhir:definition [ fhir:v "The action should be performed because the patient was determined to be off pathway." ]
  ] [
     fhir:code [ fhir:v "risk-assessment" ] ;
     fhir:display [ fhir:v "Risk assessment" ] ;
     fhir:definition [ fhir:v "The action should be performed based on a particular risk assessment." ]
  ] [
     fhir:code [ fhir:v "care-gap" ] ;
     fhir:display [ fhir:v "Care gap detected" ] ;
     fhir:definition [ fhir:v "The action should be performed to address a detected care gap." ]
  ] [
     fhir:code [ fhir:v "drug-drug-interaction" ] ;
     fhir:display [ fhir:v "Drug-drug interaction" ] ;
     fhir:definition [ fhir:v "The action should be performed to address a detected potential drug-drug interaction." ]
  ] [
     fhir:code [ fhir:v "quality-measure" ] ;
     fhir:display [ fhir:v "Quality measure" ] ;
     fhir:definition [ fhir:v "The action should be performed to bring the patient's care in line with a quality measure." ]
  ] ) . # 

<http://hl7.org/fhir/CodeSystem/medicinal-product-name-type> a fhir:CodeSystem ;
  fhir:id [ fhir:v "medicinal-product-name-type"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2026-10-22T06:40:39.479+11:00"^^xsd:dateTime ]
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem medicinal-product-name-type</b>\n            </p>\n            <a name=\"medicinal-product-name-type\"> </a>\n            <a name=\"hcmedicinal-product-name-type\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/medicinal-product-name-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">BAN\n                  <a name=\"medicinal-product-name-type-BAN\"> </a>\n                </td>\n                <td>British Approved Name</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">INN\n                  <a name=\"medicinal-product-name-type-INN\"> </a>\n                </td>\n                <td>International Non-Proprietary Name</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">INNM\n                  <a name=\"medicinal-product-name-type-INNM\"> </a>\n                </td>\n                <td>Modified International Non-Proprietary Name</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">pINN\n                  <a name=\"medicinal-product-name-type-pINN\"> </a>\n                </td>\n                <td>Proposed International Non-Proprietary Name</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">rINN\n                  <a name=\"medicinal-product-name-type-rINN\"> </a>\n                </td>\n                <td>Recommended International Non-Proprietary Name</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
