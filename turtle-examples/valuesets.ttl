<http://hl7.org/fhir/ValueSet/immunization-origin> a fhir:ValueSet ;
  fhir:id [ fhir:v "immunization-origin"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2026-10-21T19:40:39.479+00:00"^^xsd:dateTime ]
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: ValueSet immunization-origin</b>\n            </p>\n            <a name=\"immunization-origin\"> </a>\n            <a name=\"hcimmunization-origin\"> </a>\n            <ul>\n              <li>Include these codes as defined in \n                <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-immunization-origin.html\">\n                  <code>http://terminology.hl7.org/CodeSystem/immunization-origin</code>\n                </a>\n                <span title=\"Version is not explicitly stated, which means it is fixed to 1.0.1, the version found through the package references\"> version ?1.0.1</span>\n                <table class=\"none\">\n                  <tr>\n                    <td style=\"white-space:nowrap\">\n                      <b>Code</b>\n                    </td>\n                    <td>\n                      <b>Display</b>\n                    </td>\n                    <td>\n                      <b>Definition</b>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-immunization-origin.html#immunization-origin-provider\">provider</a>\n                    </td>\n                    <td>Other Provider</td>\n                    <td>The data for the immunization event originated with another provider.</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-immunization-origin.html#immunization-origin-record\">record</a>\n                    </td>\n                    <td>Written Record</td>\n                    <td>The data for the immunization event originated with a written record for the patient.</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-immunization-origin.html#immunization-origin-recall\">recall</a>\n                    </td>\n                    <td>Parent/Guardian/Patient Recall</td>\n                    <td>The data for the immunization event originated from the recollection of the patient or parent/guardian of the patient.</td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-immunization-origin.html#immunization-origin-school\">school</a>\n                    </td>\n                    <td>School Record</td>\n                    <td>The data for the immunization event originated with a school record for the patient.</td>\n                  </tr>\n                </table>\n              </li>\n            </ul>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
