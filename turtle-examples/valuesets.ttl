       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.3.407" ]
  ] [
     fhir:use [ fhir:v "old" ] ;
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.3.396" ]
  ] ) ; # 
  fhir:version [ fhir:v "6.0.0-snapshot1"] ; # 
  fhir:name [ fhir:v "ObservationReferenceRangeAppliesToCodes"] ; # 
