           fhir:code [ fhir:v "Composition" ] ;
           fhir:display [ fhir:v "Composition" ] ;
           fhir:definition [ fhir:v "Composition provides the structural backbone for assembling a set of healthcare-related information into a single logical package that provides a single coherent statement of meaning, establishes its own context and has traceability to the author who is making the statement." ] ;
