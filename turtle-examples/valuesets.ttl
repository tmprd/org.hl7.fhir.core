  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      \n      \n      \n      \n      \n            <p>This code system http://hl7.org/fhir/capability-statement-kind defines the following codes:</p>\n      \n      \n      \n      \n      \n            <table class=\"codes\">\n        \n        \n        \n        \n        \n              <tr>\n          \n          \n          \n          \n          \n                <td style=\"white-space:nowrap\">\n            \n            \n            \n            \n            \n                  <b>Code</b>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>\n            \n            \n            \n            \n            \n                  <b>Display</b>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>\n            \n            \n            \n            \n            \n                  <b>Definition</b>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>\n            \n            \n            \n            \n            \n                  <b>Comments</b>\n          \n          \n          \n          \n          \n                </td>\n        \n        \n        \n        \n        \n              </tr>\n        \n        \n        \n        \n        \n              <tr>\n          \n          \n          \n          \n          \n                <td style=\"white-space:nowrap\">instance\n            \n            \n            \n            \n            \n                  <a name=\"capability-statement-kind-instance\"> </a>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>Instance</td>\n          \n          \n          \n          \n          \n                <td>The CapabilityStatement instance represents the present capabilities of a specific system instance.  This is the kind returned by /metadata for a FHIR server end-point.</td>\n          \n          \n          \n          \n          \n                <td/>\n        \n        \n        \n        \n        \n              </tr>\n        \n        \n        \n        \n        \n              <tr>\n          \n          \n          \n          \n          \n                <td style=\"white-space:nowrap\">capability\n            \n            \n            \n            \n            \n                  <a name=\"capability-statement-kind-capability\"> </a>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>Capability</td>\n          \n          \n          \n          \n          \n                <td>The CapabilityStatement instance represents the capabilities of a system or piece of software, independent of a particular installation.</td>\n          \n          \n          \n          \n          \n                <td>Elements marked as 'optional' represent configurable capabilities</td>\n        \n        \n        \n        \n        \n              </tr>\n        \n        \n        \n        \n        \n              <tr>\n          \n          \n          \n          \n          \n                <td style=\"white-space:nowrap\">requirements\n            \n            \n            \n            \n            \n                  <a name=\"capability-statement-kind-requirements\"> </a>\n          \n          \n          \n          \n          \n                </td>\n          \n          \n          \n          \n          \n                <td>Requirements</td>\n          \n          \n          \n          \n          \n                <td>The CapabilityStatement instance represents a set of requirements for other systems to meet; e.g. as part of an implementation guide or 'request for proposal'.</td>\n          \n          \n          \n          \n          \n                <td/>\n        \n        \n        \n        \n        \n              </tr>\n      \n      \n      \n      \n      \n            </table>\n    \n    \n    \n    \n    \n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
