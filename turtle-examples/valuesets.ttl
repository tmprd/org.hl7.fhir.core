     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem vision-base-codes</b>\n            </p>\n            <a name=\"vision-base-codes\"> </a>\n            <a name=\"hcvision-base-codes\"> </a>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/vision-base-codes</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n                <td>\n                  <b>Definition</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">up\n                  <a name=\"vision-base-codes-up\"> </a>\n                </td>\n                <td>Up</td>\n                <td>top.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">down\n                  <a name=\"vision-base-codes-down\"> </a>\n                </td>\n                <td>Down</td>\n                <td>bottom.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">in\n                  <a name=\"vision-base-codes-in\"> </a>\n                </td>\n                <td>In</td>\n                <td>inner edge.</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">out\n                  <a name=\"vision-base-codes-out\"> </a>\n                </td>\n                <td>Out</td>\n                <td>outer edge.</td>\n              </tr>\n            </table>\n          </div>"^^rdf:XMLLiteral ]
  ] ; # 
