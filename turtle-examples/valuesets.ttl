           fhir:code [ fhir:v "FamilyMemberHistory" ] ;
           fhir:display [ fhir:v "FamilyMemberHistory" ] ;
           fhir:definition [ fhir:v "Significant health conditions for a person related to the patient relevant in the context of care for the patient." ] ;
