  ] [
     fhir:code [ fhir:v "resource" ] ;
     fhir:display [ fhir:v "Resource" ] ;
     fhir:definition [ fhir:v "A 'resource' - a directed acyclic graph of elements that aggregrates other types into an identifiable entity. The base FHIR resources are defined by the FHIR specification itself but other 'resources' can be defined in additional specifications (though these will not be recognized as 'resources' by the FHIR specification; i.e. they do not get end-points etc., or act as the targets of references in FHIR defined resources - though other specifications can treat them this way)." ]
  ] [
     fhir:code [ fhir:v "logical" ] ;
     fhir:display [ fhir:v "Logical" ] ;
     fhir:definition [ fhir:v "A pattern or a template that is not intended to be a real resource or complex type." ]
  ] ) . # 

