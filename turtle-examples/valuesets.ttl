           fhir:code [ fhir:v "ConceptMap" ] ;
           fhir:display [ fhir:v "ConceptMap" ] ;
           fhir:definition [ fhir:v "A statement of relationships from one set of concepts to one or more other concepts - either concepts in code systems, or data element/data element concepts, or classes in class models." ] ;
