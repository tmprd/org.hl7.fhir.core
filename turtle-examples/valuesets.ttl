<http://hl7.org/fhir/CodeSystem/regulated-authorization-case-type> a fhir:CodeSystem ;
  fhir:id [ fhir:v "regulated-authorization-case-type"] ; # 
  fhir:meta [
     fhir:lastUpdated [ fhir:v "2026-10-22T06:40:39.479+11:00"^^xsd:dateTime ]
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n            <p class=\"res-header-id\">\n              <b>Generated Narrative: CodeSystem regulated-authorization-case-type</b>\n            </p>\n            <a name=\"regulated-authorization-case-type\"> </a>\n            <a name=\"hcregulated-authorization-case-type\"> </a>\n            <div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">\n              <p style=\"margin-bottom: 0px\">Last updated: 2021-01-05T10:01:24.148+11:00</p>\n            </div>\n            <p>This case-sensitive code system \n              <code>http://hl7.org/fhir/regulated-authorization-case-type</code> defines the following codes:\n            </p>\n            <table class=\"codes\">\n              <tr>\n                <td style=\"white-space:nowrap\">\n                  <b>Code</b>\n                </td>\n                <td>\n                  <b>Display</b>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">InitialMAA\n                  <a name=\"regulated-authorization-case-type-InitialMAA\"> </a>\n                </td>\n                <td>Initial Marketing Authorization Application</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Variation\n                  <a name=\"regulated-authorization-case-type-Variation\"> </a>\n                </td>\n                <td>Variation</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">LineExtension\n                  <a name=\"regulated-authorization-case-type-LineExtension\"> </a>\n                </td>\n                <td>Line Extension</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">PSUR\n                  <a name=\"regulated-authorization-case-type-PSUR\"> </a>\n                </td>\n                <td>Periodic Safety Update Report</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Renewal\n                  <a name=\"regulated-authorization-case-type-Renewal\"> </a>\n                </td>\n                <td>Renewal</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Follow-up\n                  <a name=\"regulated-authorization-case-type-Follow-up\"> </a>\n                </td>\n                <td>Follow-up Measure</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">100000155699\n                  <a name=\"regulated-authorization-case-type-100000155699\"> </a>\n                </td>\n                <td>Specific Obligation</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">AnnualReassessment\n                  <a name=\"regulated-authorization-case-type-AnnualReassessment\"> </a>\n                </td>\n                <td>Annual Reassessment</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">UrgentSafetyRestriction\n                  <a name=\"regulated-authorization-case-type-UrgentSafetyRestriction\"> </a>\n                </td>\n                <td>Urgent Safety Restriction</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">PaediatricSubmission\n                  <a name=\"regulated-authorization-case-type-PaediatricSubmission\"> </a>\n                </td>\n                <td>Paediatric Submission</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">TransferMA\n                  <a name=\"regulated-authorization-case-type-TransferMA\"> </a>\n                </td>\n                <td>Transfer of a marketing authorization</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">LiftingSuspension\n                  <a name=\"regulated-authorization-case-type-LiftingSuspension\"> </a>\n                </td>\n                <td>Lifting of a Suspension</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Withdrawal\n                  <a name=\"regulated-authorization-case-type-Withdrawal\"> </a>\n                </td>\n                <td>Withdrawal</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">Reformatting\n                  <a name=\"regulated-authorization-case-type-Reformatting\"> </a>\n                </td>\n                <td>Reformatting</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">RMP\n                  <a name=\"regulated-authorization-case-type-RMP\"> </a>\n                </td>\n                <td>Risk Management Plan</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">ReviewSuspension\n                  <a name=\"regulated-authorization-case-type-ReviewSuspension\"> </a>\n                </td>\n                <td>Review of a Suspension of MA</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SupplementalInformation\n                  <a name=\"regulated-authorization-case-type-SupplementalInformation\"> </a>\n                </td>\n                <td>Supplemental Information</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">RepeatUse\n                  <a name=\"regulated-authorization-case-type-RepeatUse\"> </a>\n                </td>\n                <td>Repeat Use Procedure</td>\n              </tr>\n              <tr>\n                <td style=\"white-space:nowrap\">SignalDetection\n                  <a name=\"regulated-authorization-case-type-SignalDetection\"> </a>\n                </td>\n                <td>Signal detection</td>\n        