     ] [
       fhir:id [ fhir:v "SubstanceDefinition.url" ] ;
       fhir:path [ fhir:v "SubstanceDefinition.url" ] ;
       fhir:short [ fhir:v "Canonical identifier for this substance definition, represented as an absolute URI (globally unique)" ] ;
       fhir:definition [ fhir:v "An absolute URI that is used to identify this substance definition when it is referenced in a specification, model, design or an instance; also called its canonical identifier. This SHOULD be globally unique and SHOULD be a literal address at which an authoritative instance of this substance definition is (or will be) published. This URL can be the target of a canonical reference. It SHALL remain the same when the substance definition is stored on different servers." ] ;
       fhir:comment [ fhir:v "Can be a urn:uuid: or a urn:oid: but real http: addresses are preferred.  Multiple instances may share the same URL if they have a distinct version.\n\nThe determination of when to create a new version of a resource (same url, new version) vs. defining a new artifact is up to the author.  Considerations for making this decision are found in [Technical and Business Versions](resource.html#versions).\n\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the [meta.source](resource.html#meta) element to indicate where the current master source of the resource can be found." ] ;
       fhir:requirements [ fhir:v "Allows the substance definition to be referenced by a single globally unique identifier." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "uri"^^xsd:anyURI ;
           fhir:l fhir:uri
         ]
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "cnl-1" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "URL should not contain | or # - these characters make processing canonical references problematic" ] ;
