     ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "http://hl7.org/fhir/StructureDefinition/CanonicalResource"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/CanonicalResource>
     ]
