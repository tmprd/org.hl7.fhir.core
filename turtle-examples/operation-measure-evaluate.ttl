  ] ; # 
  fhir:version [ fhir:v "6.0.0-snapshot1"] ; # 
  fhir:name [ fhir:v "Evaluate"] ; # 
  fhir:title [ fhir:v "Evaluate"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:kind [ fhir:v "operation"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-10-21T19:40:39+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "HL7 International / Clinical Quality Information"] ; # 
  fhir:contact ( [
