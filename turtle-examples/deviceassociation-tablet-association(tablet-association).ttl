@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/DeviceAssociation/tablet-association> a fhir:DeviceAssociation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "tablet-association"] ; # 
  fhir:meta [
     fhir:security ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActReason"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActReason>
       ] ;
       fhir:code [ fhir:v "HTEST" ] ;
       fhir:display [ fhir:v "test health data" ]
     ] )
  ] ; # 
  fhir:contained ( <http://hl7.org/fhir/DeviceAssociation/tablet-association#example-practitioner> <http://hl7.org/fhir/DeviceAssociation/tablet-association#tablet-device> ) ; # 
  fhir:device [
     fhir:l <http://hl7.org/fhir/DeviceAssociation/tablet-association#tablet-device> ;
     fhir:reference [ fhir:v "#tablet-device" ]
  ] ; # 
  fhir:status [] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/DeviceAssociation/tablet-association#example-practitioner> ;
     fhir:reference [ fhir:v "#example-practitioner" ]
  ] ; # 
  fhir:period [
     fhir:start [ fhir:v "2023-06-01"^^xsd:date ]
  ] . # 

<http://hl7.org/fhir/DeviceAssociation/tablet-association#example-practitioner> a fhir:Practitioner ;
  fhir:id [ fhir:v "example-practitioner"] ; # 
  fhir:name ( [
     fhir:family [ fhir:v "Nguyen" ] ;
     fhir:given ( [ fhir:v "Alex" ] )
  ] ) . # 

<http://hl7.org/fhir/DeviceAssociation/tablet-association#tablet-device> a fhir:Device ;
  fhir:id [ fhir:v "tablet-device"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:name ( [
     fhir:value [ fhir:v "handPad Pro" ] ;
     fhir:type [ ]
  ] ) ; # 
  fhir:type ( [
     a sct:464572002 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "464572002" ] ;
       fhir:display [ fhir:v "Palmtop computer" ]
     ] )
  ] ) . # 

