@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/Medication/med0324> a fhir:Medication ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "med0324"] ; # 
  fhir:meta [
     fhir:security ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActReason"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActReason>
       ] ;
       fhir:code [ fhir:v "HTEST" ] ;
       fhir:display [ fhir:v "test health data" ]
     ] )
  ] ; # A Medication representing a kind of medication (a catalogue entry), used as a canonical resource:
#       url and version identify it across systems; identifier is the business identifier of the record
#       (a catalogue number). It has no instance. Compare medicationexample0325, a physical item of the same product.
  fhir:identifier ( [
     fhir:system [
       fhir:v "http://example.org/medication-catalogue"^^xsd:anyURI ;
       fhir:l <http://example.org/medication-catalogue>
     ] ;
     fhir:value [ fhir:v "CAT-AMX-500-CAP" ]
  ] ) ; # 
  fhir:code [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://www.nlm.nih.gov/research/umls/rxnorm"^^xsd:anyURI ;
         fhir:l <http://www.nlm.nih.gov/research/umls/rxnorm>
       ] ;
       fhir:code [ fhir:v "308191" ] ;
       fhir:display [ fhir:v "amoxicillin 500 MG Oral Capsule" ]
     ] )
  ] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:doseForm [
     a sct:385049006 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "385049006" ] ;
       fhir:display [ fhir:v "Capsule" ]
     ] )
  ] . # 

