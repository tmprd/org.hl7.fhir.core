@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/OperationOutcome/exception> a fhir:OperationOutcome ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "exception"] ; # 
  fhir:meta [
     fhir:security ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActReason"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActReason>
       ] ;
       fhir:code [ fhir:v "HTEST" ] ;
       fhir:display [ fhir:v "test health data" ]
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>SQL Link Communication Error (dbx = 34234)</p>\n    </div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:issue ( [
     fhir:severity [ fhir:v "error" ] ;
     fhir:code [ fhir:v "exception" ] ;
     fhir:details [
       fhir:text [ fhir:v "SQL Link Communication Error (dbx = 34234)" ]
     ]
  ] ) . # 

