<http://hl7.org/fhir/StructureDefinition/vitalsigns> a fhir:StructureDefinition ;
  fhir:id [ fhir:v "vitalsigns"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">to do</div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-summary>
     ] ;
     fhir:value [
       a fhir:Markdown ;
       fhir:v "#### Summary of the Mandatory Requirements\n\n1.  One status in `Observation.status` which has a [required](terminologies.html#required) binding to:\n    -    [ObservationStatus] value set\n1.  A category in `Observation.category` which must have:\n    -   a fixed `Observation.category.coding.system`= **'http://terminology.hl7.org/CodeSystem/observation-category'**\n    -   a fixed `Observation.category.coding.code`= **'vital-signs'**\n\n1.  A code in `Observation.code`\n    -   a fixed `Observation.code.coding.system`= **'http://loinc.org'**\n    -   a LOINC code in `Observation.code.coding.code` which has a [preferred](terminologies.html#preferred) binding to:\n         -   [Vital Signs Measurement] value set\n1.  One patient in `Observation.subject`\n1.  A date and time in `effectiveDateTime`\n1.  One of:\n    -   one `Observation.value[x]` of `Quantity` data type:\n        -   one numeric value in `Observation.valueQuantity.value`\n        -   a fixed `Observation.valueQuantity.system` = **'http://unitsofmeasure.org'**\n        -   a UCUM unit code in `Observation.valueQuantity.code` which has a [preferred](terminologies.html#preferred) binding to:\n            -   [Vital Signs Units] value set\n    -   if, based on `Observation.code`, the observation is not expected to have a value (e.g., this is a \"panel\" observation), then either:\n        -   one or more populated components (with `component.code` and either `component.value[x]` or `component.dataAbsentReason`)\n            -   `component.dataAbsentReason` has an [extensible](terminologies.html#extensible) binding to:\n                -   [Data Absent Reason] value set\n        -   one or more `hasMember` references to an `Observation` resource\n    -   if there are none of those, then one code in `Observation.dataAbsentReason`, which has an [extensible](terminologies.html#extensible) binding to:\n        -   [Data Absent Reason] value set\n\n[Vital Signs Measurement]: valueset-observation-vitalsign-measurement.html\n[Vital Signs Units]: valueset-ucum-vitals-common.html\n[ObservationStatus]: valueset-observation-status.html\n[Data Absent Reason]: valueset-data-absent-reason.html\n"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 4
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "oo"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "normative"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/tools/StructureDefinition/profile-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/tools/StructureDefinition/profile-summary>
     ] ;
     fhir:value [
       a fhir:String ;
       fhir:v "#### Summary of the Mandatory Requirements\n\n1.  One status in `Observation.status` which has a [required](terminologies.html#required) binding to:\n    -    [ObservationStatus] value set\n1.  A category in `Observation.category` which must have:\n    -   a fixed `Observation.category.coding.system`= **'http://terminology.hl7.org/CodeSystem/observation-category'**\n    -   a fixed `Observation.category.coding.code`= **'vital-signs'**\n\n1.  A code in `Observation.code`\n    -   a fixed `Observation.code.coding.system`= **'http://loinc.org'**\n    -   a LOINC code in `Observation.code.coding.code` which has a [preferred](terminologies.html#preferred) binding to:\n         -   [Vital Signs Measurement] value set\n1.  One patient in `Observation.subject`\n1.  A date and time in `effectiveDateTime`\n1.  One of:\n    -   one `Observation.value[x]` of `Quantity` data type:\n        -   one numeric value in `Observation.valueQuantity.value`\n        -   a fixed `Observation.valueQuantity.system` = **'http://unitsofmeasure.org'**\n        -   a UCUM unit code in `Observation.valueQuantity.code` which has a [preferred](terminologies.html#preferred) binding to:\n            -   [Vital Signs Units] value set\n    -   if, based on `Observation.code`, the observation is not expected to have a value (e.g., this is a \"panel\" observation), then either:\n        -   one or more populated components (with `component.code` and either `component.value[x]` or `component.dataAbsentReason`)\n            -   `component.dataAbsentReason` has an [extensible](terminologies.html#extensible) binding to:\n                -   [Data Absent Reason] value set\n        -   one or more `hasMember` references to an `Observation` resource\n    -   if there are none of those, then one code in `Observation.dataAbsentReason`, which has an [extensible](terminologies.html#extensible) binding to:\n        -   [Data Absent Reason] value set\n\n[Vital Signs Measurement]: valueset-observation-vitalsign-measurement.html\n[Vital Signs Units]: valueset-ucum-vitals-common.html\n[ObservationStatus]: valueset-observation-status.html\n[Data Absent Reason]: valueset-data-absent-reason.html\n"
     ]
  ] ) ; # 
