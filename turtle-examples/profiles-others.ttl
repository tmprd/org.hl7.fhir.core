       fhir:short [ fhir:v "Resource version" ] ;
       fhir:definition [ fhir:v "This points to the version of the resource that was created as a result of this historical record action.  Typically only a single resource will be referenced, but if the same action is performed to multiple resources in the context of a transaction, some systems MAY link multiple resource instances." ] ;
       fhir:comment [ fhir:v "The reference SHALL be version-specific." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
