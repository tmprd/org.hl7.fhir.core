  ] ; # 
  fhir:derivation [ fhir:v "constraint"] ; # 
  fhir:snapshot [
     fhir:extension ( [
       fhir:url [
         fhir:v "http://hl7.org/fhir/tools/StructureDefinition/snapshot-base-version"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/tools/StructureDefinition/snapshot-base-version>
       ] ;
       fhir:value [
         a fhir:String ;
         fhir:v "6.0.0-snapshot1"
       ]
     ] ) ;
     fhir:element ( [
       fhir:id [ fhir:v "Bundle" ] ;
       fhir:path [ fhir:v "Bundle" ] ;
       fhir:short [ fhir:v "Contains a collection of resources" ] ;
       fhir:definition [ fhir:v "A container for a collection of resources." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
         fhir:path [ fhir:v "Bundle" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "bdl-1" ] ;
         fhir:requirements [ fhir:v "There are only two Bundle types where paging is supported and there's a need to know the size of the result set beyond what's in the current instance." ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "total only when a search or history" ] ;
         fhir:expression [ fhir:v "total.empty() or (type = 'searchset') or (type = 'history')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "entry.search only when a search" ] ;
         fhir:expression [ fhir:v "(type = 'searchset') or entry.search.empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-7" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "FullUrl must be unique in a bundle, or else entries with the same fullUrl must have different meta.versionId (except in history and collection bundles)" ] ;
         fhir:expression [ fhir:v "(type = 'history') or (type = 'collection') or entry.where(fullUrl.exists()).select(fullUrl&iif(resource.meta.versionId.exists(), resource.meta.versionId, '')).isDistinct()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-9" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have an identifier with a system and a value" ] ;
         fhir:expression [ fhir:v "type = 'document' implies (identifier.system.exists() and identifier.value.exists())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-10" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have a date" ] ;
         fhir:expression [ fhir:v "type = 'document' implies (timestamp.hasValue())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-11" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have a Composition as the first resource" ] ;
         fhir:expression [ fhir:v "type = 'document' implies entry.first().resource.is(Composition)" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-12" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A message must have a MessageHeader as the first resource" ] ;
         fhir:expression [ fhir:v "type = 'message' implies entry.first().resource.is(MessageHeader)" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-13" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A subscription-notification must have a SubscriptionStatus as the first resource" ] ;
         fhir:expression [ fhir:v "type = 'subscription-notification' implies entry.first().resource.is(SubscriptionStatus)" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-14" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "entry.request.method PATCH not allowed for history" ] ;
         fhir:expression [ fhir:v "type = 'history' implies entry.request.method != 'PATCH'" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-15" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Bundle resources where type is not transaction, transaction-response, batch, or batch-response or when the request is a POST SHALL have Bundle.entry.fullUrl populated" ] ;
         fhir:expression [ fhir:v "type='transaction' or type='transaction-response' or type='batch' or type='batch-response' or entry.all(fullUrl.exists() or request.method='POST')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-16" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Issue.severity for all issues within the OperationOutcome must be either 'information' or 'warning'." ] ;
         fhir:expression [ fhir:v "issues.exists() implies (issues.issue.severity = 'information' or issues.issue.severity = 'warning')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-17" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Use and meaning of issues for documents has not been validated because the content will not be rendered in the document." ] ;
         fhir:expression [ fhir:v "type = 'document' implies issues.empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-18" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Self link is required for searchsets." ] ;
         fhir:expression [ fhir:v "type = 'searchset' implies link.where(relation = 'self' and url.exists()).exists()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-3a" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For collections of type document, message, searchset or collection, all entries must contain resources, and not have request or response elements" ] ;
         fhir:expression [ fhir:v "type in ('document' | 'message' | 'searchset' | 'collection') implies entry.all(resource.exists() and request.empty() and response.empty())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-3b" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For collections of type history, all entries must contain request or response elements, and resources if the method is POST, PUT or PATCH" ] ;
         fhir:expression [ fhir:v "type = 'history' implies entry.all(request.exists() and response.exists() and ((request.method in ('POST' | 'PATCH' | 'PUT')) = resource.exists()))" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-3c" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For collections of type transaction or batch, all entries must contain request elements, and resources if the method is POST, PUT or PATCH" ] ;
         fhir:expression [ fhir:v "type in ('transaction' | 'batch') implies entry.all(request.method.exists() and ((request.method in ('POST' | 'PATCH' | 'PUT')) = resource.exists()))" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-3d" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For collections of type transaction-response or batch-response, all entries must contain response elements" ] ;
         fhir:expression [ fhir:v "type in ('transaction-response' | 'batch-response') implies entry.all(response.exists())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v false ] ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "Entity. Role, or Act,N/A" ]
       ] [
         fhir:identity [ fhir:v "w5" ] ;
         fhir:map [ fhir:v "infrastructure.structure" ]
       ] [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "N/A" ]
       ] [
         fhir:identity [ fhir:v "cda" ] ;
         fhir:map [ fhir:v "ClinicalDocument, if bundle.type = document" ]
       ] )
     ] [
       fhir:id [ fhir:v "Bundle.id" ] ;
       fhir:path [ fhir:v "Bundle.id" ] ;
       fhir:short [ fhir:v "Logical id of this artifact" ] ;
       fhir:definition [ fhir:v "The logical id of the resource, as used in the URL for the resource. Once assigned, this value never changes." ] ;
       fhir:comment [ fhir:v "Within the context of the FHIR RESTful interactions, the resource has an id except for cases like the create and conditional update. Otherwise, the use of the resource id depends on the given use case." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Resource.id" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:extension ( [
