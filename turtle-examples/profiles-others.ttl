  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Vital Signs Panel Profile" ] ;
       fhir:definition [ fhir:v "This profile defines the top-level grouping structure for a set of vital signs. It has no value in Observation.valueQuantity ; instead, it just includes related links (with type=has-member) to the Observations in this set (e.g. respiratory rate, heart rate, BP - with a minimum of 2 members of the set/panel required)." ]
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:short [ fhir:v "Vital Signs Panel" ] ;
       fhir:definition [ fhir:v "Vital Signs Panel" ] ;
       fhir:alias ( [ fhir:v "Panel Name" ] [ fhir:v "Panel Code" ] ) ;
       fhir:pattern [
         a fhir:CodeableConcept, loinc:85353-1 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://loinc.org"^^xsd:anyURI ;
             fhir:l <http://loinc.org>
           ] ;
           fhir:code [ fhir:v "85353-1" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "VitalSignsPanel"
           ]
         ] ) ;
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:description [ fhir:v "This identifies the set of LOINC codes that are appropriate for representing a panel of vital sign measurements in Observation.code." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-vitalsign-panel"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/observation-vitalsign-panel>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.organizer" ] ;
       fhir:path [ fhir:v "Observation.organizer" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.hasMember" ] ;
       fhir:path [ fhir:v "Observation.hasMember" ] ;
       fhir:min [ fhir:v "2"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

<http://hl7.org/fhir/StructureDefinition/resprate> a fhir:StructureDefinition ;
  fhir:id [ fhir:v "resprate"] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-summary>
     ] ;
     fhir:value [
       a fhir:Markdown ;
       fhir:v "#### Summary of the Mandatory Requirements\r\r1.  One instance of `Observation.code.coding` which must have\r    -   a fixed `Observation.code.coding.system` = **'http://loinc.org'**\r    -   a fixed  `Observation.code.coding.code` = **'9279-1'**\r    -   additional Coding repetitions representing a more specific code for the measurement obtained MAY be included in `Observation.code`.\r1. Either one `Observation.valueQuantity` or, if there is no value, one code in `Observation.dataAbsentReason`\r   - Each `Observation.valueQuantity` must have:\r     - one numeric value in `Observation.valueQuantity.value`\r     - a fixed `Observation.valueQuantity.system` = **'http://unitsofmeasure.org'**\r     - a UCUM unit code in `Observation.valueQuantity.code` = **'/min'**"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 4
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "oo"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status>
     ] ;
