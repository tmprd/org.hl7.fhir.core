  fhir:snapshot [
     fhir:extension ( [
       fhir:url [
         fhir:v "http://hl7.org/fhir/tools/StructureDefinition/snapshot-base-version"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/tools/StructureDefinition/snapshot-base-version>
