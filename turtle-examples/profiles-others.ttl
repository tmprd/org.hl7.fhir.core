         fhir:human [ fhir:v "Observation.component.dataAbsentReason SHALL only be present if Observation.component.value[x] is not present" ] ;
         fhir:expression [ fhir:v "component.empty() or component.where(dataAbsentReason.exists()).all(value.empty())" ] ;
