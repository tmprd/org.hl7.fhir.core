     fhir:element ( [
       fhir:id [ fhir:v "Bundle" ] ;
       fhir:path [ fhir:v "Bundle" ] ;
       fhir:short [ fhir:v "Contains a collection of resources" ] ;
       fhir:definition [ fhir:v "A container for a collection of resources." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
         fhir:path [ fhir:v "Bundle" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "bdl-1" ] ;
         fhir:requirements [ fhir:v "There are only two Bundle types where paging is supported and there's a need to know the size of the result set beyond what's in the current instance." ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "total only when a search or history" ] ;
         fhir:expression [ fhir:v "total.empty() or (type = 'searchset') or (type = 'history')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "entry.search only when a search" ] ;
         fhir:expression [ fhir:v "(type = 'searchset') or entry.search.empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-7" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "FullUrl must be unique in a bundle, or else entries with the same fullUrl must have different meta.versionId (except in history and collection bundles)" ] ;
         fhir:expression [ fhir:v "(type = 'history') or (type = 'collection') or entry.where(fullUrl.exists()).select(fullUrl&iif(resource.meta.versionId.exists(), resource.meta.versionId, '')).isDistinct()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-9" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have an identifier with a system and a value" ] ;
         fhir:expression [ fhir:v "type = 'document' implies (identifier.system.exists() and identifier.value.exists())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-10" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have a date" ] ;
         fhir:expression [ fhir:v "type = 'document' implies (timestamp.hasValue())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-11" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A document must have a Composition as the first resource" ] ;
         fhir:expression [ fhir:v "type = 'document' implies entry.first().resource.is(Composition)" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-12" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "A message must have a MessageHeader as the first resource" ] ;
         fhir:expression [ fhir:v "type = 'message' implies entry.first().resource.is(MessageHeader)" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
