         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/provenance-history-agent-type"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/provenance-history-agent-type>
         ]
       ]
