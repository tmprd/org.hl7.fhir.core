<http://hl7.org/fhir/StructureDefinition/bodyweight> a fhir:StructureDefinition ;
  fhir:id [ fhir:v "bodyweight"] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-summary>
     ] ;
     fhir:value [
       a fhir:Markdown ;
       fhir:v "#### Summary of the Mandatory Requirements\r\r1.  One instance of `Observation.code.coding` which must have\r    -   a fixed `Observation.code.coding.system` = **'http://loinc.org'**\r    -   a fixed  `Observation.code.coding.code` = **'29463-7'**\r    -   additional Coding repetitions representing a more specific code for the measurement obtained MAY be included in `Observation.code`.\r1. Either one `Observation.valueQuantity` or, if there is no value, one code in `Observation.dataAbsentReason`\r   - Each `Observation.valueQuantity` must have:\r     - one numeric value in `Observation.valueQuantity.value`\r     - a fixed `Observation.valueQuantity.system` = **'http://unitsofmeasure.org'**\r     - a UCUM unit code in `Observation.valueQuantity.code` = **'kg'**, **'g'**, **'[lb_av]'** or **'[oz_av]'**"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 4
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "oo"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "normative"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/tools/StructureDefinition/profile-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/tools/StructureDefinition/profile-summary>
     ] ;
     fhir:value [
       a fhir:String ;
       fhir:v "#### Summary of the Mandatory Requirements\r\r1.  One instance of `Observation.code.coding` which must have\r    -   a fixed `Observation.code.coding.system` = **'http://loinc.org'**\r    -   a fixed  `Observation.code.coding.code` = **'29463-7'**\r    -   additional Coding repetitions representing a more specific code for the measurement obtained MAY be included in `Observation.code`.\r1. Either one `Observation.valueQuantity` or, if there is no value, one code in `Observation.dataAbsentReason`\r   - Each `Observation.valueQuantity` must have:\r     - one numeric value in `Observation.valueQuantity.value`\r     - a fixed `Observation.valueQuantity.system` = **'http://unitsofmeasure.org'**\r     - a UCUM unit code in `Observation.valueQuantity.code` = **'kg'**, **'g'**, **'[lb_av]'** or **'[oz_av]'**"
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "http://hl7.org/fhir/StructureDefinition/bodyweight"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/StructureDefinition/bodyweight>
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "urn:ietf:rfc:3986"^^xsd:anyURI ;
       fhir:l <urn:ietf:rfc:3986>
     ] ;
     fhir:value [ fhir:v "urn:oid:2.16.840.1.113883.4.642.5.1465" ]
  ] ) ; # 
  fhir:version [ fhir:v "6.0.0-snapshot1"] ; # 
  fhir:name [ fhir:v "Observationbodyweight"] ; # 
  fhir:title [ fhir:v "Observation Body Weight Profile"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2018-08-11"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "HL7 International / Orders and Observations"] ; # 
  fhir:contact ( [
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://www.hl7.org/Special/committees/orders/index.cfm Orders and Observations" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "FHIR Body Weight Profile"] ; # 
  fhir:fhirVersion [ fhir:v "6.0.0-snapshot1"] ; # 
