         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For collections of type transaction-response or batch-response, all entries must contain response elements" ] ;
         fhir:expression [ fhir:v "type in ('transaction-response' | 'batch-response') implies entry.all(response.exists())" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
