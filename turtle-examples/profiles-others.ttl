         fhir:key [ fhir:v "bdl-15" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Bundle resources where type is not transaction, transaction-response, batch, or batch-response or when the request is a POST SHALL have Bundle.entry.fullUrl populated" ] ;
         fhir:expression [ fhir:v "type='transaction' or type='transaction-response' or type='batch' or type='batch-response' or entry.all(fullUrl.exists() or request.method='POST')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-16" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Issue.severity for all issues within the OperationOutcome must be either 'information' or 'warning'." ] ;
         fhir:expression [ fhir:v "issues.exists() implies (issues.issue.severity = 'information' or issues.issue.severity = 'warning')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-17" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Use and meaning of issues for documents has not been validated because the content will not be rendered in the document." ] ;
         fhir:expression [ fhir:v "type = 'document' implies issues.empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
       ] [
         fhir:key [ fhir:v "bdl-18" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Self link is required for searchsets." ] ;
         fhir:expression [ fhir:v "type = 'searchset' implies link.where(relation = 'self' and url.exists()).exists()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Bundle>
         ]
