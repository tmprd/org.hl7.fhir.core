         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Self link is required for searchsets." ] ;
         fhir:expression [ fhir:v "type = 'searchset' implies link.where(relation = 'self' and url.exists()).exists()" ] ;
