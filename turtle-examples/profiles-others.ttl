     ] )
  ] ) ; # 
  fhir:description [ fhir:v "This profile holds all the requirements and constraints related to a FHIR document."] ; # 
  fhir:fhirVersion [ fhir:v "6.0.0-snapshot1"] ; # 
  fhir:mapping ( [
     fhir:identity [ fhir:v "v2" ] ;
