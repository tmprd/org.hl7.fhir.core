  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Body Weight Profile" ] ;
       fhir:definition [ fhir:v "This profile defines  how to represent body weight observations in FHIR using a standard LOINC code and UCUM units of measure." ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "vs-4" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For single vital signs observations (that do not require use of components or hasMember), then either a value[x] or a data absent reason must be present." ] ;
         fhir:expression [ fhir:v "dataAbsentReason.exists() or value.exists()" ]
       ] )
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:short [ fhir:v "Body Weight" ] ;
       fhir:definition [ fhir:v "Body Weight" ] ;
       fhir:pattern [
         a fhir:CodeableConcept, loinc:29463-7 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://loinc.org"^^xsd:anyURI ;
             fhir:l <http://loinc.org>
           ] ;
           fhir:code [ fhir:v "29463-7" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "VitalSignsBodyWeight"
           ]
         ] ) ;
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:description [ fhir:v "This identifies the set of LOINC codes that are appropriate for representing body weight vital sign measurements in Observation.code." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-vitalsign-bodyweight"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/observation-vitalsign-bodyweight>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.valueQuantity" ] ;
       fhir:path [ fhir:v "Observation.valueQuantity" ] ;
       fhir:condition ( [ fhir:v "vsp-4" ] ) ;
