       fhir:sliceName [ fhir:v "Author" ] ;
       fhir:short [ fhir:v "Author" ] ;
       fhir:definition [ fhir:v "Author." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
