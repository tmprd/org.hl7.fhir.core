         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/ucum-bodyweight"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/ucum-bodyweight>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.dataAbsentReason" ] ;
