     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Vital Signs Panel Profile" ] ;
       fhir:definition [ fhir:v "This profile defines the top-level grouping structure for a set of vital signs. It has no value in Observation.valueQuantity ; instead, it just includes related links (with type=has-member) to the Observations in this set (e.g. respiratory rate, heart rate, BP - with a minimum of 2 members of the set/panel required)." ] ;
       fhir:comment [ fhir:v "Used for simple observations such as device measurements, laboratory atomic results, vital signs, height, weight, smoking status, comments, etc.  Other resources are used to provide context for observations such as laboratory reports, etc." ] ;
       fhir:alias ( [ fhir:v "Vital Sign" ] [ fhir:v "Measurement" ] [ fhir:v "Result" ] [ fhir:v "Test Performed" ] [ fhir:v "Observable" ] [ fhir:v "Vital Signs" ] [ fhir:v "Results" ] [ fhir:v "Tests" ] ) ;
