         fhir:key [ fhir:v "bdl-16" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Issue.severity for all issues within the OperationOutcome must be either 'information' or 'warning'." ] ;
         fhir:expression [ fhir:v "issues.exists() implies (issues.issue.severity = 'information' or issues.issue.severity = 'warning')" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Bundle"^^xsd:anyURI ;
