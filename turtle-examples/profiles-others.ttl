  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Blood Pressure Profile" ] ;
       fhir:definition [ fhir:v "This profile defines  how to represent Blood Pressure observations in FHIR using a standard LOINC code and UCUM units of measure.  This is a grouping structure. It has no value in Observation.valueQuantity and contains two components (systolic and diastolic). If one or both are not performed, that is reflected in the dataAbsentReason of the corresponding component." ]
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
