             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "ObservationValueAbsentReason"
           ]
         ] ) ;
         fhir:strength [ fhir:v "extensible" ] ;
         fhir:description [ fhir:v "Codes specifying why the result (`Observation.value[x]`) is missing." ] ;
