         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If Observation.component.code is the same as Observation.code, then Observation.value SHALL NOT be present (the Observation.component.value[x] holds the value)." ] ;
         fhir:expression [ fhir:v "value.empty() or component.code.where(coding.intersect(%resource.code.coding).exists()).empty()" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Observation"^^xsd:anyURI ;
