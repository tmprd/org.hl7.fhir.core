           fhir:l <http://hl7.org/fhir/ValueSet/observation-vitalsign-bppanel>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:max [ fhir:v "0" ]
