         ]
       ] ) ;
       fhir:mustSupport [ fhir:v false ] ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "OBX-7" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "outboundRelationship[typeCode=REFV]/target[classCode=OBS, moodCode=EVN]" ]
       ] )
     ] )
  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:short [ fhir:v "FHIR Head Circumference Profile" ] ;
       fhir:definition [ fhir:v "This profile defines  how to represent Head Circumference observations in FHIR using a standard LOINC code and UCUM units of measure." ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "vs-4" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "For single vital signs observations (that do not require use of components or hasMember), then either a value[x] or a data absent reason must be present." ] ;
         fhir:expression [ fhir:v "dataAbsentReason.exists() or value.exists()" ]
       ] )
     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:short [ fhir:v "Head Circumference" ] ;
       fhir:definition [ fhir:v "Head Circumference" ] ;
       fhir:pattern [
         a fhir:CodeableConcept, loinc:9843-4 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://loinc.org"^^xsd:anyURI ;
             fhir:l <http://loinc.org>
           ] ;
           fhir:code [ fhir:v "9843-4" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "VitalSignsHeadCircum"
           ]
         ] ) ;
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:description [ fhir:v "This identifies the set of LOINC codes that are appropriate for representing head circumference vital sign measurements in Observation.code." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-vitalsign-headcircum"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/observation-vitalsign-headcircum>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.valueQuantity" ] ;
       fhir:path [ fhir:v "Observation.valueQuantity" ] ;
       fhir:condition ( [ fhir:v "vsp-4" ] ) ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/tools/StructureDefinition/binding-definition"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/tools/StructureDefinition/binding-definition>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "Common UCUM units for body length measures such as Body Height and Head Circumference."
           ]
         ] [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "BodyLengthUnits"
           ]
         ] ) ;
         fhir:strength [ fhir:v "required" ] ;
         fhir:description [ fhir:v "cm | [in_i]" ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/ucum-bodylength"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/ucum-bodylength>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.dataAbsentReason" ] ;
       fhir:path [ fhir:v "Observation.dataAbsentReason" ] ;
       fhir:condition ( [ fhir:v "vsp-4" ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

<http://hl7.org/fhir/StructureDefinition/bp> a fhir:StructureDefinition ;
  fhir:id [ fhir:v "bp"] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-summary>
     ] ;
     fhir:value [
       a fhir:Markdown ;
       fhir:v "#### Summary of the Mandatory Requirements\r\r1.  One instance of `Observation.code.coding` which must have\r    -   a fixed `Observation.code.coding.system` = **'http://loinc.org'**\r    -   a fixed  `Observation.code.coding.code` = **'85354-9'**\r    -   additional Coding repetitions representing a more specific code for the measurement obtained MAY be included in `Observation.code`.\r1.  No value in `Observation.value[x]`\r1.  One instance of `Observation.component` for systolic blood pressure which must have:\r    -   one instance of `Observation.component.code.coding` which must have\r        -   a fixed `Observation.component.code.coding.system`=**'http://loinc.org'**\r        -   fixed  `Observation.component.code.coding.code`= **'8480-6'**\r        -   additional Coding repetitions representing a more specific code for the systolic blood pressure measurement obtained MAY be included in `Observation.component.code`.\r    -   either one `Observation.component.valueQuantity` or, if there is no value, one code in `Observation.component.dataAbsentReason`\r        -   each `Observation.component.valueQuantity` must have:\r            -   one numeric value in `Observation.component.valueQuantity.value`\r            -   a fixed `Observation.component.valueQuantity.system` = **'http://unitsofmeasure.org'**\r            -   a UCUM unit code in `Observation.component.valueQuantity.code` = **'mm[Hg]'**\r1.  One instance of `Observation.component` for diastolic blood pressure which must have:\r    -   one instance of `Observation.component.code.coding` which must have\r        -   a fixed `Observation.component.code.coding.system`=**'http://loinc.org'**\r        -   fixed  `Observation.component.code.coding.code`= **'8462-4'**\r        -   additional Coding repetitions representing a more specific code for the diastolic blood pressure measurement obtained MAY be included in `Observation.component.code`.\r    -   either one `Observation.component.valueQuantity` or, if there is no value, one code in `Observation.component.dataAbsentReason`\r        -   each `Observation.component.valueQuantity` must have:\r            -   one numeric value in `Observation.component.valueQuantity.value`\r            -   a fixed `Observation.component.valueQuantity.system` = **'http://unitsofmeasure.org'**\r            -   a UCUM unit code in `Observation.component.valueQuantity.code` = **'mm[Hg]'**"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 4
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "oo"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "normative"
     ]
  ] [
     fhir:url [
       fhir:v "http://hl7.org/fhir/tools/StructureDefinition/profile-summary"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/tools/StructureDefinition/profile-summary>
     ] ;
     fhir:value [
       a fhir:String ;
       fhir:v "#### Summary of the Mandatory Requirements\r\r1.  One instance of `Observation.code.coding` which must have\r    -   a fixed `Observation.code.coding.system` = **'http://loinc.org'**\r    -   a fixed  `Observation.code.coding.code` = **'85354-9'**\r    -   additional Coding repetitions representing a more specific code for the measurement obtained MAY be included in `Observation.code`.\r1.  No value in `Observation.value[x]`\r1.  One instance of `Observation.component` for systolic blood pressure which must have:\r    -   one instance of `Observation.component.code.coding` which must have\r      -   a fixed `Observation.component.code.coding.system`=**'http://loinc.org'**\r      -   fixed  `Observation.component.code.coding.code`= **'8480-6'**\r      -   additional Coding repetitions representing a more specific code for the systolic blood pressure measurement obtained MAY be included in `Observation.component.code`.\r    -    either one `Observation.component.valueQuantity` or, if there is no value, one code in `Observation.component.dataAbsentReason`\r      -   each `Observation.component.valueQuantity` must have:\r        - one numeric value in `Observation.component.valueQuantity.value`\r        - a fixed `Observation.component.valueQuantity.system` = **'http://unitsofmeasure.org'**\r        - a UCUM unit code in `Observation.component.valueQuantity.code` = **'mm[Hg]'**\r1.  One instance of `Observation.component` for diastolic blood pressure which must have:\r    -   one instance of `Observation.component.code.coding` which must have\r      -   a fixed `Observation.component.code.coding.system`=**'http://loinc.org'**\r      -   fixed  `Observation.component.code.coding.code`= **'8462-4'**\r      -   additional Coding repetitions representing a more specific code for the diastolic blood pressure measurement obtained MAY be included in `Observation.component.code`.\r    -    either one `Observation.component.valueQuantity` or, if there is no value, one code in `Observation.component.dataAbsentReason`\r      -   each `Observation.component.valueQuantity` must have:\r        - one numeric value in `Observation.component.valueQuantity.value`\r        - a fixed `Observation.component.valueQuantity.system` = **'http://unitsofmeasure.org'**\r        - a UCUM unit code in `Observation.component.valueQuantity.code` = **'mm[Hg]'**"
     ]
  ] ) ; # 
