         fhir:identity [ fhir:v "w5" ] ;
         fhir:map [ fhir:v "infrastructure.information" ]
       ] [
         fhir:identity [ fhir:v "w3c.prov" ] ;
         fhir:map [ fhir:v "Activity" ]
       ] )
     ] [
