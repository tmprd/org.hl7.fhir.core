# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/ServiceRequest/ft4> a fhir:ServiceRequest ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ft4"] ; # 
  fhir:meta [
     fhir:security ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActReason"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActReason>
       ] ;
       fhir:code [ fhir:v "HTEST" ] ;
       fhir:display [ fhir:v "test health data" ]
     ] )
  ] ; # 
  fhir:contained ( <http://hl7.org/fhir/ServiceRequest/ft4#tsh> ) ; # 
  fhir:basedOn ( [
     fhir:l <http://hl7.org/fhir/ServiceRequest/ft4#tsh> ;
     fhir:reference [ fhir:v "#tsh" ] ;
     fhir:display [ fhir:v "Original request for TSH test" ]
  ] ) ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:intent [ fhir:v "reflex-order"] ; # 
  fhir:code [
     fhir:concept [
       a loinc:3024-7 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://loinc.org"^^xsd:anyURI ;
           fhir:l <http://loinc.org>
         ] ;
         fhir:code [ fhir:v "3024-7" ] ;
         fhir:display [ fhir:v "Thyroxine (T4) free [Mass/volume] in Serum or Plasma" ]
       ] ) ;
       fhir:text [ fhir:v "Free T4" ]
     ]
  ] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/pat2> ;
     fhir:reference [ fhir:v "Patient/pat2" ]
  ] ; # 
  fhir:occurrence [
     a fhir:DateTime ;
     fhir:v "2015-08-27T09:33:27+07:00"^^xsd:dateTime
  ] ; # 
  fhir:requester [
     fhir:l <http://hl7.org/fhir/Practitioner/example> ;
     fhir:reference [ fhir:v "Practitioner/example" ]
  ] . # 

<http://hl7.org/fhir/ServiceRequest/ft4#tsh> a fhir:ServiceRequest ;
  fhir:id [ fhir:v "tsh"] ; # 
  fhir:status [ fhir:v "completed"] ; # 
  fhir:intent [ fhir:v "original-order"] ; # 
  fhir:code [
     fhir:concept [
       a loinc:3016-3 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://loinc.org"^^xsd:anyURI ;
           fhir:l <http://loinc.org>
         ] ;
         fhir:code [ fhir:v "3016-3" ] ;
         fhir:display [ fhir:v "Thyrotropin [Units/volume] in Serum or Plasma" ]
       ] ) ;
       fhir:text [ fhir:v "TSH" ]
     ]
  ] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/pat2> ;
     fhir:reference [ fhir:v "Patient/pat2" ]
  ] . # 

<http://hl7.org/fhir/Patient/pat2> a fhir:Patient .

<http://hl7.org/fhir/Practitioner/example> a fhir:Practitioner .

