     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>Aortic dissection involves the ascending aorta and aortic arch. The overall morphology describes the dissection. Each included structure identifies its true lumen.</p>\n    </div>"^^rdf:XMLLiteral ]
